# NOTARYOS — copy to .env and fill secrets. Never commit real .env.
PORT=8080
ADDR=:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=notaryos
DB_PASS=change-me
DB_NAME=notaryos
DB_TLS=false
SESSION_NAME=notaryos_sess
COOKIE_SECURE=false
TRUSTED_PROXIES=127.0.0.1/32,::1/128
STORAGE_DIR=./storage
# Field encryption (UU PDP): base64 32-byte, e.g. hasil `openssl rand -base64 32`
NOTARYOS_FIELD_KEY=
# Optional integrations (leave empty to disable):
# Kanonis S3 (menang atas alias lawas S3_ENDPOINT/S3_BUCKET di bawah):
NOTARYOS_S3_ENDPOINT=
NOTARYOS_S3_BUCKET=
NOTARYOS_S3_REGION=us-east-1
NOTARYOS_S3_ACCESS=
NOTARYOS_S3_SECRET=
# Alias lawas (tetap didukung config.go bila kanonis kosong):
S3_ENDPOINT=
S3_BUCKET=
AI_BASE_URL=
OCR_BINARY=
# Notifikasi: kosong = in-app saja + tombol WA manual (wa.me) di halaman permohonan.
# Isi bila ingin handoff otomatis (best-effort, tak menggagalkan pengingat in-app).
# Email via relay SMTP:
NOTARYOS_SMTP_HOST=
NOTARYOS_SMTP_PORT=587
NOTARYOS_SMTP_USER=
NOTARYOS_SMTP_PASS=
NOTARYOS_SMTP_FROM=
# Gateway WA/webhook (https publik saja; payload JSON + HMAC X-Signature):
NOTARYOS_NOTIFY_WEBHOOK=
NOTARYOS_NOTIFY_SECRET=
# Web Push (infra langganan + tombol uji; TANPA kirim otomatis).
# Hasilkan sekali (jangan commit): npx -y web-push generate-vapid-keys
# Public key dibagikan ke browser; private key HANYA di env server.
# Kosong = tombol "Aktifkan notifikasi" di /settings nonaktif (jujur).
NOTARYOS_VAPID_PUBLIC=
NOTARYOS_VAPID_PRIVATE=
NOTARYOS_VAPID_SUBJECT=mailto:office@contoh.id
# APP_BASE_URL dipakai untuk QR kuitansi (cth. https://notaris.contoh.id). Kosong = QR berisi kode saja.
APP_BASE_URL=
# Seed admin awal (scripts/seed):
SEED_OFFICE=Kantor Notaris Contoh
SEED_NOTARY=Nama Notaris, S.H.
SEED_SK=SK-000
SEED_ADDR=Jl. Contoh 1
SEED_PHONE=021-000
SEED_EMAIL=office@contoh.id
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@contoh.id
SEED_ADMIN_PASS=change-me-min-8
# Override DSN penuh (kosong = dirakit dari DB_* di atas; internal/config/config.go):
DB_DSN=
# Audit hash-chain (kosong = turunan NOTARYOS_FIELD_KEY; internal/audit/audit.go):
NOTARYOS_CHAIN_KEY=
# ClamAV on-demand scan DMS (kosong = tombol Pindai nonaktif; internal/app/dms.go):
CLAMAV_ADDR=
# Mode perawatan: 1 = tolak semua non-GET/HEAD (internal/app/ops_growth.go):
READ_ONLY=false
# Backup berkas lokal (deploy/backup/backup_files.sh; diabaikan bila mode S3):
FILES_BACKUP_DIR=/var/backups/notaryos/files
FILES_RETENTION_DAYS=30
# Backup DB terenkripsi (deploy/backup/backup.sh; key-id/email GPG penerima):
GPG_RECIPIENT=
# Pemicu pengingat harian (deploy/reminder/run-reminder.sh; idealnya di /etc/notaryos/reminder.env):
REMINDER_BASE_URL=http://127.0.0.1:8080
REMINDER_USER=
REMINDER_PASS=
# Test integrasi saja (tests/integration_test.go; jangan isi di .env produksi):
# NOTARYOS_TEST_DSN=
