{{define "client_detail"}}{{template "head" .}}{{template "page_open" .}}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/app">Dashboard</a></li><li class="breadcrumb-item"><a href="/clients">Daftar Klien</a></li><li class="breadcrumb-item active">{{.Data.Client.FullName}}</li></ol></nav>
<div class="card mb-3"><div class="card-body"><div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
<div class="d-flex align-items-center gap-3"><span class="avatar avatar-lg">{{slice .Data.Client.FullName 0 1}}</span><div><h2 class="mb-0">{{.Data.Client.FullName}}</h2>
<span class="badge bg-azure-lt">{{.Data.Client.Kind}}</span> <span class="badge {{if eq .Data.Client.Status "ACTIVE"}}bg-green-lt{{else}}bg-yellow-lt{{end}}">{{.Data.Client.Status}}</span>
{{if .Data.Client.RegNumber}}<span class="badge bg-blue-lt">{{.Data.Client.RegNumber}}</span>{{end}}
<div><span class="text-secondary small">{{.Data.Client.Phone}}{{if .Data.Client.WANumber}} · WA {{.Data.Client.WANumber}}{{end}} · {{.Data.Client.Email}}</span></div></div></div>
<div class="d-flex gap-2 flex-wrap">{{if .Data.CanEdit}}<a class="btn btn-outline-primary" href="/clients/{{.Data.Client.ID}}/edit">Edit Profil</a>{{end}}<a class="btn btn-outline-primary" href="/requests?client={{.Data.Client.ID}}">+ Permohonan</a><button class="btn btn-primary" type="button" onclick="document.querySelector('a[href=\'#tab-doc\']').click();document.getElementById('tab-doc').scrollIntoView()">Unggah Berkas</button></div>
</div></div></div>
<div class="row g-2 mb-3">
<div class="col-sm-6 col-lg"><div class="card"><div class="card-body"><div class="subheader">Pekerjaan</div><div class="h1 mb-0">{{len .Data.Services}}</div><div class="small text-secondary">tercatat</div></div></div></div>
<div class="col-sm-6 col-lg"><div class="card"><div class="card-body"><div class="subheader">Dokumen</div><div class="h1 mb-0">{{len .Data.Files}}</div><div class="small text-secondary">berkas privat</div></div></div></div>
<div class="col-sm-6 col-lg"><div class="card"><div class="card-body"><div class="subheader">Total tagihan</div><div class="h1 mb-0">Rp {{.Data.Fin.Outstanding}}</div><div class="small text-secondary">belum lunas · {{.Data.Fin.Invoices}} invoice</div></div></div></div>
<div class="col-sm-6 col-lg"><div class="card"><div class="card-body"><div class="subheader">Terlambat</div><div class="h1 mb-0">{{.Data.Fin.Overdue}}</div><div class="small text-secondary">invoice jatuh tempo</div></div></div></div>
</div>
<div class="card"><div class="card-header"><ul class="nav nav-tabs card-header-tabs" data-bs-toggle="tabs">
<li class="nav-item"><a href="#tab-info" class="nav-link active" data-bs-toggle="tab">Overview</a></li>
<li class="nav-item"><a href="#tab-id" class="nav-link" data-bs-toggle="tab">Identitas</a></li>
<li class="nav-item"><a href="#tab-doc" class="nav-link" data-bs-toggle="tab">Dokumen</a></li>
<li class="nav-item"><a href="#tab-svc" class="nav-link" data-bs-toggle="tab">Pekerjaan</a></li>
<li class="nav-item"><a href="#tab-fin" class="nav-link" data-bs-toggle="tab">Keuangan</a></li>
<li class="nav-item"><a href="#tab-comms" class="nav-link" data-bs-toggle="tab">Komunikasi</a></li>
<li class="nav-item"><a href="#tab-act" class="nav-link" data-bs-toggle="tab">Aktivitas</a></li>
<li class="nav-item"><a href="#tab-set" class="nav-link" data-bs-toggle="tab">Pengaturan</a></li>
</ul></div>
<div class="card-body"><div class="tab-content">
<div class="tab-pane active" id="tab-info">
<div class="row"><div class="col-md-6"><h4>Profil</h4><dl class="row">
<dt class="col-4">Jenis</dt><dd class="col-8">{{.Data.Client.Kind}}</dd>
<dt class="col-4">Status</dt><dd class="col-8">{{.Data.Client.Status}}</dd>
<dt class="col-4">Reg</dt><dd class="col-8">{{.Data.Client.RegNumber}}</dd>
<dt class="col-4">Telepon</dt><dd class="col-8">{{.Data.Client.Phone}} / {{.Data.Client.AltPhone}}</dd>
<dt class="col-4">WA</dt><dd class="col-8">{{.Data.Client.WANumber}}</dd>
<dt class="col-4">Email</dt><dd class="col-8">{{.Data.Client.Email}}</dd>
<dt class="col-4">NPWP</dt><dd class="col-8">{{.Data.Client.NPWP}}</dd>
<dt class="col-4">Tgl lahir</dt><dd class="col-8">{{.Data.Client.BirthDate}} · {{.Data.Client.BirthPlace}} ({{.Data.Client.Gender}})</dd>
<dt class="col-4">Kewarganegaraan</dt><dd class="col-8">{{.Data.Client.Nationality}}</dd>
<dt class="col-4">Status kawin</dt><dd class="col-8">{{.Data.Client.Marital}}</dd>
<dt class="col-4">Pekerjaan</dt><dd class="col-8">{{.Data.Client.Occupation}} {{if .Data.Client.Education}}· {{.Data.Client.Education}}{{end}}</dd>
<dt class="col-4">Alamat KTP</dt><dd class="col-8">{{.Data.Client.IDAddress}}</dd>
<dt class="col-4">Domisili</dt><dd class="col-8">{{.Data.Client.Domicile}}</dd>
<dt class="col-4">Wilayah</dt><dd class="col-8">{{.Data.Client.Village}}, {{.Data.Client.District}}, {{.Data.Client.City}}, {{.Data.Client.Province}} {{.Data.Client.Postal}}</dd>
<dt class="col-4">Korespondensi</dt><dd class="col-8">{{.Data.Client.Correspondence}}</dd>
<dt class="col-4">Klien sejak</dt><dd class="col-8">{{.Data.Client.FirstClientDate}} · via {{.Data.Client.Source}}</dd>
<dt class="col-4">Label</dt><dd class="col-8">{{.Data.Client.Labels}}</dd>
<dt class="col-4">Catatan internal</dt><dd class="col-8 text-warning">{{.Data.Client.InternalNotes}}</dd>
</dl></div>
<div class="col-md-6"><h4>Kemungkinan duplikat</h4>
<form method="post" action="/clients/merge/preview"><div class="d-flex gap-1">{{template "csrf" .}}<input type="hidden" name="winner_id" value="{{.Data.Client.ID}}"/><input class="form-control" name="loser_id" placeholder="ID klien ganda"/><button class="btn btn-outline-warning" type="submit">Cek Gabung</button></div></form>
<div class="mt-2">{{range .Data.Duplicates}}<div class="alert alert-warning py-2"><a href="/clients/{{.ID}}">{{.FullName}}</a> — {{.Reason}}</div>{{else}}<p class="text-secondary">Tidak ada indikasi duplikat.</p>{{end}}</div>
<h4 class="mt-3">Perwakilan</h4>{{range .Data.Reps}}<div class="mb-2"><strong>{{.Name}}</strong> <span class="text-secondary">{{.Position}} · {{.Phone}}</span></div>{{else}}<p class="text-secondary">Belum ada perwakilan.</p>{{end}}
<form method="post" action="/clients/{{.Data.Client.ID}}/reps">{{template "csrf" .}}
<div class="mb-2"><input class="form-control" name="name" placeholder="Nama" required/></div>
<div class="row"><div class="col-6 mb-2"><input class="form-control" name="position" placeholder="Jabatan"/></div>
<div class="col-6 mb-2"><input class="form-control" name="phone" placeholder="Telepon"/></div></div>
<div class="mb-2"><input class="form-control" name="authority" placeholder="Dasar kewenangan"/></div>
<button class="btn btn-primary w-100" type="submit">Tambah Perwakilan</button></form></div></div>
</div>
<div class="tab-pane" id="tab-id">
<p class="text-secondary">Identitas terverifikasi manusia — OCR tidak pernah dianggap terverifikasi otomatis.</p>
<div class="table-responsive"><table class="table card-table"><thead><tr><th>Jenis</th><th>Nama</th><th>NIK akhir</th><th>Status</th><th></th></tr></thead>
<tbody>{{range .Data.Identities}}<tr><td>{{.IDType}}</td><td>{{.FullName}}</td><td><code>•••• {{.NIKLast4}}</code></td><td><span class="badge {{if eq .Status "VERIFIED"}}bg-green-lt{{else if eq .Status "REJECTED"}}bg-red-lt{{else}}bg-yellow-lt{{end}}">{{.Status}}</span>{{if .Inconsistent}} <span class="badge bg-red-lt">INKONSISTEN</span>{{end}}</td>
<td>{{if $.Data.CanVerify}}<form method="post" action="/identities/{{.ID}}/status" class="d-flex gap-1">{{template "csrf" $}}<select class="form-select form-select-sm" name="status" style="max-width:150px"><option>PENDING</option><option>VERIFIED</option><option>NEEDS_REVISION</option><option>REJECTED</option></select><input class="form-control form-control-sm" name="note" placeholder="Catatan"/><button class="btn btn-sm btn-success" type="submit">Proses</button></form>
<form method="post" action="/identities/{{.ID}}/flag" class="d-inline">{{template "csrf" $}}<input type="hidden" name="flag" value="{{if .Inconsistent}}0{{else}}1{{end}}"/><button class="btn btn-sm btn-ghost-warning" type="submit">{{if .Inconsistent}}Buka flag{{else}}Tandai inkonsisten{{end}}</button></form>{{end}}</td></tr>
<tr><td colspan="5" class="small text-secondary">Riwayat: {{range index $.Data.VerHist .ID}}{{.At}} {{.Actor}} {{.From}}→{{.To}}{{if .Note}} ({{.Note}}){{end}} · {{end}}</td></tr>
{{else}}<tr><td colspan="5" class="text-center text-secondary py-4">Belum ada identitas.</td></tr>{{end}}</tbody></table></div>
<form method="post" action="/clients/{{.Data.Client.ID}}/identities"><div class="row">
{{template "csrf" .}}
<div class="col-md-3 mb-2"><select class="form-select" name="id_type"><option value="KTP">KTP</option><option value="KK">KK</option><option value="NPWP">NPWP</option><option value="PASSPORT">Paspor</option><option value="OTHER">Lainnya</option></select></div>
<div class="col-md-3 mb-2"><input class="form-control" name="nik" placeholder="NIK/NPWP/paspor (terenkripsi)"/></div>
<div class="col-md-4 mb-2"><input class="form-control" name="full_name" placeholder="Nama sesuai identitas" required/></div>
<div class="col-md-2 mb-2"><button class="btn btn-primary w-100" type="submit">Tambah</button></div>
</div></form>
</div>
<div class="tab-pane" id="tab-doc">
<div class="table-responsive"><table class="table card-table"><thead><tr><th>Nama</th><th>Ukuran</th><th>OCR</th><th></th></tr></thead>
<tbody>{{range .Data.Files}}<tr><td><a href="/files/{{.ID}}">{{.Name}}</a></td><td>{{.Size}}</td><td>{{.OCRStatus}}</td>
<td><div class="d-flex gap-1"><a class="btn btn-sm btn-outline-primary" href="/files/{{.ID}}">Unduh</a><form method="post" action="/files/{{.ID}}/ocr">{{template "csrf" $}}<button class="btn btn-sm btn-ghost-secondary" type="submit">Jalankan OCR</button></form></div></td></tr>
{{else}}<tr><td colspan="4" class="text-center text-secondary py-4">Belum ada berkas.</td></tr>{{end}}</tbody></table></div>
<form method="post" action="/clients/{{.Data.Client.ID}}/files" enctype="multipart/form-data"><div class="d-flex gap-2">
{{template "csrf" .}}<input class="form-control" type="file" name="file" required/><button class="btn btn-primary" type="submit">Unggah</button>
</div></form>
</div>
<div class="tab-pane" id="tab-svc">
<div class="list-group list-group-flush">{{range .Data.Services}}<a class="list-group-item" href="/requests/{{.ID}}"><span class="badge bg-blue-lt me-2">{{.Status}}</span>{{.Title}} <span class="text-secondary small">· {{.Service}}</span></a>{{else}}<div class="list-group-item text-secondary">Belum ada permohonan.</div>{{end}}</div>
</div>
<div class="tab-pane" id="tab-fin">
<div class="row"><div class="col-md-6"><dl class="row"><dt class="col-5">Invoice</dt><dd class="col-7">{{.Data.Fin.Invoices}}</dd><dt class="col-5">Sudah dibayar</dt><dd class="col-7">Rp {{.Data.Fin.Paid}}</dd><dt class="col-5">Belum lunas</dt><dd class="col-7"><strong>Rp {{.Data.Fin.Outstanding}}</strong></dd><dt class="col-5">Terlambat</dt><dd class="col-7">{{.Data.Fin.Overdue}} invoice</dd></dl></div>
<div class="col-md-6"><a class="btn btn-outline-primary" href="/finance?client={{.Data.Client.ID}}">Lihat di Keuangan →</a></div></div>
</div>
<div class="tab-pane" id="tab-comms">
<div class="timeline">{{range .Data.Timeline}}<div class="mb-2"><span class="badge bg-azure-lt me-2">{{.Kind}}</span><span class="text-secondary small">{{.At}}</span><div>{{.Text}}</div></div>{{else}}<p class="text-secondary">Belum ada aktivitas.</p>{{end}}</div>
<h4 class="mt-3">Catat komunikasi</h4>
<form method="post" action="/clients/{{.Data.Client.ID}}/notes"><div class="row">{{template "csrf" .}}
<div class="col-md-3 mb-2"><select class="form-select" name="kind"><option value="NOTE">Catatan</option><option value="MEETING">Pertemuan</option><option value="FOLLOWUP">Follow-up</option><option value="COMPLAINT">Keluhan</option></select></div>
<div class="col-md-9 mb-2"><input class="form-control" name="title" placeholder="Judul" required/></div>
<div class="col-12 mb-2"><textarea class="form-control" name="body" rows="2" placeholder="Isi"></textarea></div>
<div class="col-md-6 mb-2"><input class="form-control" type="datetime-local" name="occurred_at"/></div>
<div class="col-md-6 mb-2 text-end"><button class="btn btn-primary" type="submit">Simpan</button></div>
</div></form>
<h4 class="mt-3">Riwayat catatan</h4>
{{range .Data.Notes}}<div class="mb-2 pb-2 border-bottom"><strong>{{.Kind}}</strong> — {{.Title}} <span class="text-secondary small">{{.OccurredAt}} · {{.CreatedByName}}</span><div>{{.Body}}</div></div>{{else}}<p class="text-secondary">Belum ada catatan.</p>{{end}}
</div>
<div class="tab-pane" id="tab-act">
<div class="list-group list-group-flush">{{range .Data.Trail}}<div class="list-group-item"><span class="badge bg-azure-lt me-2">{{.Action}}</span><span class="text-secondary small">{{.At}}</span></div>{{else}}<div class="list-group-item text-secondary">Belum ada jejak audit.</div>{{end}}</div>
</div>
<div class="tab-pane" id="tab-set">
<p class="text-secondary">Pengaturan klien (status, penanggung jawab, label).</p>
<a class="btn btn-outline-primary" href="/clients/{{.Data.Client.ID}}/edit">Edit Profil Lengkap</a>
</div>
</div></div></div>
{{template "page_close" .}}{{end}}
