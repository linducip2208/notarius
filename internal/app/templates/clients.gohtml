{{define "client_rows"}}{{range .}}<tr><td><a href="/clients/{{.ID}}">{{.FullName}}</a></td><td>{{.Kind}}</td><td>{{.Phone}}</td><td>{{.Email}}</td></tr>{{else}}<tr><td colspan="4" class="text-center text-secondary py-4">Tidak ada klien.</td></tr>{{end}}{{end}}

{{define "clients"}}{{template "head" .}}{{template "page_open" .}}
<div class="card"><div class="card-header d-flex justify-content-between"><h3 class="card-title">Daftar Klien</h3><a class="btn btn-primary" href="/clients/new">Klien Baru</a></div>
<div class="card-body border-bottom"><input class="form-control" type="search" name="q" placeholder="Cari nama / telepon / email…" hx-get="/clients" hx-target="#rows" hx-trigger="keyup changed delay:300ms" hx-swap="innerHTML"/></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>Nama</th><th>Jenis</th><th>Telepon</th><th>Email</th></tr></thead>
<tbody id="rows">{{template "client_rows" .Data}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "client_new"}}{{template "head" .}}{{template "page_open" .}}
<form class="card" method="post" action="/clients">{{template "csrf" .}}<div class="card-header"><h3 class="card-title">Klien Baru</h3></div>
<div class="card-body">
{{if .Data}}{{if .Data.Error}}<div class="alert alert-danger">{{.Data.Error}}</div>{{end}}{{end}}
<div class="row"><div class="col-md-6 mb-3"><label class="form-label">Jenis</label><select class="form-select" name="kind"><option value="individual">Perorangan</option><option value="corporate">Badan usaha</option></select></div>
<div class="col-md-6 mb-3"><label class="form-label">Nama lengkap / badan usaha</label><input class="form-control" name="full_name" required/></div></div>
<div class="row"><div class="col-md-6 mb-3"><label class="form-label">Telepon</label><input class="form-control" name="phone" required/></div>
<div class="col-md-6 mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email"/></div></div>
<div class="mb-3"><label class="form-label">Alamat</label><textarea class="form-control" name="address" rows="2"></textarea></div>
<div class="mb-3"><label class="form-label">NPWP (opsional)</label><input class="form-control" name="npwp"/></div>
</div><div class="card-footer text-end"><button class="btn btn-primary" type="submit">Simpan</button></div></form>
{{template "page_close" .}}{{end}}

{{define "client_detail"}}{{template "head" .}}{{template "page_open" .}}
<div class="row"><div class="col-md-7"><div class="card"><div class="card-header"><h3 class="card-title">{{.Data.Client.FullName}}</h3></div>
<div class="card-body"><dl class="row">
<dt class="col-4">Jenis</dt><dd class="col-8">{{.Data.Client.Kind}}</dd>
<dt class="col-4">Telepon</dt><dd class="col-8">{{.Data.Client.Phone}}</dd>
<dt class="col-4">Email</dt><dd class="col-8">{{.Data.Client.Email}}</dd>
<dt class="col-4">Alamat</dt><dd class="col-8">{{.Data.Client.Address}}</dd>
<dt class="col-4">NPWP</dt><dd class="col-8">{{.Data.Client.NPWP}}</dd>
</dl></div></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Identitas (verifikasi manusia wajib)</h3></div>
<div class="table-responsive"><table class="table card-table"><thead><tr><th>Jenis</th><th>Nama</th><th>NIK akhir</th><th>Terverifikasi</th><th></th></tr></thead>
<tbody>{{range .Data.Identities}}<tr><td>{{.IDType}}</td><td>{{.FullName}}</td><td>•••• {{.NIKLast4}}</td><td>{{.Verified}}</td>
<td>{{if $.Data.CanVerify}}{{if not .Verified}}<form method="post" action="/identities/{{.ID}}/verify">{{template "csrf" $}}<button class="btn btn-sm btn-success" type="submit">Verifikasi</button></form>{{end}}{{end}}</td></tr>
{{else}}<tr><td colspan="5" class="text-center text-secondary py-3">Belum ada identitas.</td></tr>{{end}}</tbody></table></div>
<form method="post" action="/clients/{{.Data.Client.ID}}/identities"><div class="card-body row">
{{template "csrf" .}}
<div class="col-md-3 mb-2"><select class="form-select" name="id_type"><option value="KTP">KTP</option><option value="KK">KK</option><option value="NPWP">NPWP</option><option value="PASSPORT">Paspor</option><option value="OTHER">Lainnya</option></select></div>
<div class="col-md-3 mb-2"><input class="form-control" name="nik" placeholder="NIK/NPWP (terenkripsi)"/></div>
<div class="col-md-4 mb-2"><input class="form-control" name="full_name" placeholder="Nama sesuai identitas" required/></div>
<div class="col-md-2 mb-2"><button class="btn btn-primary w-100" type="submit">Tambah</button></div>
</div></form></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Berkas (privat, maks PDF/JPG/PNG)</h3></div>
<div class="table-responsive"><table class="table card-table"><thead><tr><th>Nama</th><th>Ukuran</th><th>OCR</th><th></th></tr></thead>
<tbody>{{range .Data.Files}}<tr><td>{{.Name}}</td><td>{{.Size}}</td><td>{{.OCRStatus}}</td>
<td><form method="post" action="/files/{{.ID}}/ocr">{{template "csrf" $}}<button class="btn btn-sm btn-ghost-primary" type="submit">Jalankan OCR</button></form></td></tr>
{{else}}<tr><td colspan="4" class="text-center text-secondary py-3">Belum ada berkas.</td></tr>{{end}}</tbody></table></div>
<form method="post" action="/clients/{{.Data.Client.ID}}/files" enctype="multipart/form-data"><div class="card-body d-flex gap-2">
{{template "csrf" .}}<input class="form-control" type="file" name="file" required/><button class="btn btn-primary" type="submit">Unggah</button>
</div></form></div>
</div>
<div class="col-md-5">
<div class="card"><div class="card-header"><h3 class="card-title">Kemungkinan duplikat</h3></div>
<div class="card-body">{{range .Data.Duplicates}}<div class="alert alert-warning"><a href="/clients/{{.ID}}">{{.FullName}}</a> — {{.Reason}}</div>{{else}}<p class="text-secondary">Tidak ada indikasi duplikat.</p>{{end}}</div></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Perwakilan</h3></div>
<div class="card-body">{{range .Data.Reps}}<div class="mb-2"><strong>{{.Name}}</strong> <span class="text-secondary">{{.Position}} · {{.Phone}}</span></div>{{else}}<p class="text-secondary">Belum ada perwakilan.</p>{{end}}
<form method="post" action="/clients/{{.Data.Client.ID}}/reps">{{template "csrf" .}}
<div class="mb-2"><input class="form-control" name="name" placeholder="Nama" required/></div>
<div class="row"><div class="col-6 mb-2"><input class="form-control" name="position" placeholder="Jabatan"/></div>
<div class="col-6 mb-2"><input class="form-control" name="phone" placeholder="Telepon"/></div></div>
<div class="mb-2"><input class="form-control" name="authority" placeholder="Dasar kewenangan"/></div>
<button class="btn btn-primary w-100" type="submit">Tambah Perwakilan</button></form></div></div>
</div></div>
{{template "page_close" .}}{{end}}
