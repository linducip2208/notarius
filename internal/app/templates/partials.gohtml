{{define "head"}}<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content="NOTARIUS — Sistem Manajemen Kantor Notaris Indonesia. Kelola klien, akta, repertorium, protokol, dan keuangan dengan aman."/>
<title>{{.Title}} — NOTARIUS</title>
<link rel="stylesheet" href="/assets/vendor/tabler.min.css"/>
<link rel="stylesheet" href="/assets/notarius/notarius.css"/>
<script src="/assets/vendor/htmx.min.js"></script>
</head>{{end}}

{{define "sidebar"}}<aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="light">
<div class="container-fluid">
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu"><span class="navbar-toggler-icon"></span></button>
<h1 class="navbar-brand navbar-brand-autodark mt-2"><span style="color:var(--nt-gold)">N</span> NOTARIUS</h1>
<div class="collapse navbar-collapse" id="sidebar-menu">
<form method="get" action="/search" class="px-3 mb-2"><input class="form-control" name="q" placeholder="Cari klien/akta…"/></form>
<ul class="navbar-nav pt-lg-3">
<li class="nav-item"><span class="nav-link disabled text-uppercase small">Workspace</span></li>
<li class="nav-item"><a class="nav-link" href="/app">Dashboard</a></li>
<li class="nav-item"><a class="nav-link" href="/appointments">Janji Temu</a></li>
<li class="nav-item"><a class="nav-link" href="/tasks">Tugas</a></li>
<li class="nav-item"><a class="nav-link" href="/documents">Dokumen</a></li>
{{if can .Role "client.view"}}<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Klien</span></li>
<li class="nav-item"><a class="nav-link" href="/clients">Klien</a></li>
<li class="nav-item"><a class="nav-link" href="/portal">Portal Klien</a></li>{{end}}
<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Layanan & Akta</span></li>
<li class="nav-item"><a class="nav-link" href="/requests">Permohonan</a></li>
<li class="nav-item"><a class="nav-link" href="/deeds">Akta</a></li>
{{if can .Role "template.manage"}}<li class="nav-item"><a class="nav-link" href="/templates">Template</a></li>{{end}}
<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Register</span></li>
{{if can .Role "repertorium.manage"}}<li class="nav-item"><a class="nav-link" href="/repertorium">Repertorium</a></li>{{end}}
{{if can .Role "protocol.view"}}<li class="nav-item"><a class="nav-link" href="/protocols">Protokol</a></li>{{end}}
{{if can .Role "legalization.process"}}<li class="nav-item"><a class="nav-link" href="/legalisasi">Legalisasi</a></li>{{end}}
<li class="nav-item"><a class="nav-link" href="/wills">Wasiat</a></li>
<li class="nav-item"><a class="nav-link" href="/gov">AHU &amp; OSS</a></li>
{{if can .Role "finance.view"}}<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Keuangan</span></li>
<li class="nav-item"><a class="nav-link" href="/finance">Keuangan</a></li>
<li class="nav-item"><a class="nav-link" href="/expenses">Pengeluaran</a></li>
<li class="nav-item"><a class="nav-link" href="/tariffs">Tarif</a></li>{{end}}
{{if can .Role "reports.view"}}<li class="nav-item"><a class="nav-link" href="/reports">Laporan</a></li>
<li class="nav-item"><a class="nav-link" href="/audit">Audit Log</a></li>{{end}}
{{if can .Role "office.manage"}}<li class="nav-item"><a class="nav-link" href="/office">Kantor</a></li>{{end}}
<li class="nav-item"><a class="nav-link" href="/settings">Pengaturan</a></li>
</ul>
<div class="my-2 px-3 text-secondary small">Peran: {{.Role}} · {{.UserName}}</div>
<form method="post" action="/logout" class="px-3 pb-3">{{template "csrf" .}}<button class="btn btn-outline-danger w-100" type="submit">Keluar</button></form>
</div>
</div>
</aside>{{end}}

{{define "csrf"}}<input type="hidden" name="csrf" value="{{.CSRF}}"/>{{end}}

{{define "flash"}}{{if .Flash}}<div class="alert alert-success" role="alert">{{.Flash}}</div>{{end}}{{end}}

{{define "page_open"}}<body>
<div class="page">
{{template "sidebar" .}}
<div class="page-wrapper">
<div class="topbar d-print-none"><div class="container-xl d-flex align-items-center gap-2 py-2">
<form method="get" action="/search" class="flex-fill d-none d-md-block"><input class="form-control" name="q" placeholder="Cari menu, klien, atau dokumen…"/></form>
<a class="btn btn-ghost-primary" href="/tasks" title="Tugas">☰</a>
<form method="post" action="/notifications/read" class="d-inline">{{template "csrf" .}}<button class="btn btn-ghost-primary" type="submit" title="Notifikasi">🔔</button></form>
<div class="dropdown">
<a href="#" class="d-flex align-items-center gap-2 text-decoration-none text-dark" data-bs-toggle="dropdown"><span class="avatar-circle">{{if .UserName}}{{slice .UserName 0 1}}{{else}}?{{end}}</span><span class="d-none d-md-block"><strong>{{.UserName}}</strong><br/><span class="small text-secondary">{{.Role}}</span></span></a>
<div class="dropdown-menu dropdown-menu-end">
<a class="dropdown-item" href="/mfa">Keamanan (MFA)</a>
<a class="dropdown-item" href="/office">Profil Kantor</a>
<div class="dropdown-divider"></div>
<form method="post" action="/logout">{{template "csrf" .}}<button class="dropdown-item text-danger" type="submit">Keluar</button></form>
</div>
</div>
</div></div>
<div class="page-header d-print-none"><div class="container-xl"><h2 class="page-title">{{.Title}}</h2></div></div>
<div class="page-body"><div class="container-xl">
{{template "flash" .}}{{end}}

{{define "page_close"}}</div></div>
</div>
</div>
<script src="/assets/vendor/tabler.min.js"></script>
</body>
</html>{{end}}
