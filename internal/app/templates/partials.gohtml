{{define "head"}}<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content="{{.Brand.AppName}} — Sistem Manajemen Kantor Notaris Indonesia. Kelola klien, akta, repertorium, protokol, dan keuangan dengan aman."/>
<title>{{.Title}} — {{.Brand.AppName}}</title>
{{if .Brand.FaviconURL}}<link rel="icon" type="image/png" href="{{.Brand.FaviconURL}}"/>{{else}}<link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg"/>{{end}}
<link rel="stylesheet" href="/assets/vendor/tabler.min.css"/>
<link rel="stylesheet" href="/assets/notarius/tokens.css"/>
<style>:root{--wl-primary:{{.Brand.Primary}};--wl-secondary:{{.Brand.Secondary}};--wl-accent:{{.Brand.Accent}};--wl-header:{{.Brand.HeaderBG}};--wl-radius:{{.Brand.ButtonRadius}}}body{font-family:{{css .Brand.FontStack}}}.btn-primary{background:var(--wl-primary);border-color:var(--wl-primary)}.navbar-brand,.page-title{color:var(--wl-secondary)}.skip-link{position:absolute;left:-9999px;top:0;z-index:1050}.skip-link:focus{left:8px;top:8px}</style>
<script src="/assets/vendor/htmx.min.js"></script>
</head>{{end}}

{{define "sidebar"}}<aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark" style="background:{{.Brand.SidebarBG}}" aria-label="Navigasi utama">
<div class="container-fluid">
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu"><span class="navbar-toggler-icon"></span></button>
<h1 class="navbar-brand navbar-brand-autodark mt-2">{{if .Brand.LogoURL}}<img src="{{.Brand.LogoURL}}" alt="{{.Brand.AppName}}" style="height:34px;width:34px;object-fit:cover;object-position:center;border-radius:8px;vertical-align:middle"/>{{else}}<img src="/assets/brand/saktinotaris-logo-b.png" alt="{{.Brand.AppName}}" style="height:34px;width:34px;object-fit:cover;object-position:center;border-radius:8px;vertical-align:middle"/>{{end}} <span class="text-white">{{.Brand.AppName}}</span></h1>
{{if .Acting}}<div class="px-3"><div class="alert alert-warning py-2 mb-2 small">Mode lintas-kantor AKTIF ({{.OfficeName}}). <form method="post" action="/offices/act" class="d-inline">{{template "csrf" .}}<button class="btn btn-sm btn-outline-warning" type="submit">Keluar mode</button></form></div></div>{{end}}
<div class="collapse navbar-collapse" id="sidebar-menu">
<form method="get" action="/search" class="px-3 mb-2" role="search"><input class="form-control" name="q" placeholder="Cari klien/akta…" aria-label="Pencarian cepat"/></form>
<ul class="navbar-nav pt-lg-3" id="mainnav">
<li class="nav-item"><span class="nav-link disabled text-uppercase small">Workspace</span></li>
<li class="nav-item"><a class="nav-link" href="/app">🏠 Dashboard</a></li>
<li class="nav-item"><a class="nav-link" href="/appointments">📅 Janji Temu</a></li>
<li class="nav-item"><a class="nav-link" href="/tasks">☰ Tugas</a></li>
<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Dokumen (DMS)</span></li>
<li class="nav-item"><a class="nav-link" href="/dms">📊 Overview DMS</a></li>
<li class="nav-item"><a class="nav-link" href="/dms/library">📁 Library</a></li>
<li class="nav-item"><a class="nav-link" href="/dms/search">🔍 Pencarian</a></li>
<li class="nav-item"><a class="nav-link" href="/dms/ocr">⚙ Antrean OCR</a></li>
<li class="nav-item"><a class="nav-link" href="/dms/duplicates">⧉ Duplikat</a></li>
<li class="nav-item"><a class="nav-link" href="/dms/archive">🗄 Arsip Fisik</a></li>
<li class="nav-item"><a class="nav-link" href="/dms/retention">⏳ Retensi & Hold</a></li>
{{if can .Role "template.manage"}}<li class="nav-item"><a class="nav-link" href="/dms/categories">🏷 Kategori</a></li>
<li class="nav-item"><a class="nav-link" href="/dms/checklists">☑ Checklist</a></li>{{end}}
{{if can .Role "client.view"}}<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Manajemen Klien</span></li>
<li class="nav-item"><a class="nav-link" href="/clients">👥 Daftar Klien{{if .Pending}}<span class="badge bg-yellow text-dark ms-auto">{{.Pending}}</span>{{end}}</a></li>
<li class="nav-item"><a class="nav-link" href="/portal">🖥 Portal Klien</a></li>{{end}}
<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Layanan Notaris</span></li>
<li class="nav-item"><a class="nav-link" href="/requests">🧾 Permohonan{{if .Pending}}<span class="badge bg-red ms-auto">{{.Pending}}</span>{{end}}</a></li>
<li class="nav-item"><a class="nav-link" href="/deeds">📝 Akta</a></li>
{{if can .Role "template.manage"}}<li class="nav-item"><a class="nav-link" href="/templates">📄 Template</a></li>{{end}}
<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Register & Protokol</span></li>
{{if can .Role "repertorium.manage"}}<li class="nav-item"><a class="nav-link" href="/repertorium">📚 Repertorium</a></li>{{end}}
{{if can .Role "protocol.view"}}<li class="nav-item"><a class="nav-link" href="/protocols">🗄 Arsip Protokol</a></li>{{end}}
{{if can .Role "legalization.process"}}<li class="nav-item"><a class="nav-link" href="/legalisasi">✅ Legalisasi</a></li>{{end}}
<li class="nav-item"><a class="nav-link" href="/wills">🕊 Wasiat</a></li>
<li class="nav-item"><a class="nav-link" href="/gov">🏛 AHU &amp; OSS</a></li>
{{if can .Role "finance.view"}}<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Keuangan</span></li>
<li class="nav-item"><a class="nav-link" href="/finance">💰 Invoice</a></li>
<li class="nav-item"><a class="nav-link" href="/expenses">💸 Pengeluaran</a></li>
<li class="nav-item"><a class="nav-link" href="/tariffs">🏷 Tarif</a></li>{{end}}
{{if can .Role "reports.view"}}<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Laporan</span></li>
<li class="nav-item"><a class="nav-link" href="/reports">📊 Laporan</a></li>
<li class="nav-item"><a class="nav-link" href="/audit">📜 Audit Log</a></li>{{end}}
{{if can .Role "website.view"}}<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Website CMS</span></li>
<li class="nav-item"><a class="nav-link" href="/cms">🌐 Website</a></li>
<li class="nav-item"><a class="nav-link" href="/cms/pages">📄 Halaman</a></li>
<li class="nav-item"><a class="nav-link" href="/cms/articles">📰 Artikel</a></li>
<li class="nav-item"><a class="nav-link" href="/cms/media">🖼 Media</a></li>
{{if can .Role "website.branding.manage"}}<li class="nav-item"><a class="nav-link" href="/cms/branding">🎨 Branding</a></li>{{end}}
{{if can .Role "website.seo.manage"}}<li class="nav-item"><a class="nav-link" href="/cms/site">🔍 SEO & Domain</a></li>{{end}}{{end}}
<li class="nav-item"><span class="nav-link disabled text-uppercase small mt-2">Pengaturan</span></li>
{{if can .Role "office.manage"}}<li class="nav-item"><a class="nav-link" href="/office">🏢 Kantor</a></li>{{end}}
<li class="nav-item"><a class="nav-link" href="/settings">⚙ Pengaturan</a></li>
{{if eq .Role "super_admin"}}<li class="nav-item"><a class="nav-link" href="/offices">🏢 Multi-Kantor</a></li>{{end}}
{{if can .Role "users.manage"}}<li class="nav-item"><a class="nav-link" href="/roles">🔑 Role & Permission</a></li>{{end}}
</ul>
<div class="my-2 px-3 text-secondary small">Peran: {{.Role}} · {{.UserName}}</div>
<form method="post" action="/logout" class="px-3 pb-3">{{template "csrf" .}}<button class="btn btn-outline-danger w-100" type="submit">Keluar</button></form>
</div>
</div>
</aside>{{end}}

{{define "csrf"}}<input type="hidden" name="csrf" value="{{.CSRF}}"/>{{end}}

{{define "flash"}}{{if .Flash}}<div class="alert alert-success" role="alert">{{.Flash}}</div>{{end}}{{end}}

{{define "page_open"}}<body>
<a class="skip-link btn btn-primary" href="#konten">Lewati ke konten utama</a>
<div class="page">
{{template "sidebar" .}}
<div class="page-wrapper">
<header class="navbar navbar-expand-md d-print-none"><div class="container-xl d-flex align-items-center gap-2 py-2">
<nav aria-label="breadcrumb" class="d-none d-lg-block"><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="/app">Beranda</a></li><li class="breadcrumb-item active">{{.Title}}</li></ol></nav>
<form method="get" action="/search" class="flex-fill d-none d-md-block" role="search"><div class="input-icon"><span class="input-icon-addon" aria-hidden="true">🔍</span><input class="form-control" name="q" placeholder="Cari menu, klien, atau dokumen…" aria-label="Pencarian menu, klien, atau dokumen"/></div></form>
<div class="dropdown">
<button class="btn btn-primary" data-bs-toggle="dropdown">+ Buat</button>
<div class="dropdown-menu dropdown-menu-end">
{{if can .Role "client.create"}}<a class="dropdown-item" href="/clients/new">👥 Klien Baru</a>{{end}}
<a class="dropdown-item" href="/requests">🧾 Permohonan Baru</a>
{{if can .Role "deed.draft"}}<a class="dropdown-item" href="/deeds">📝 Draft Akta</a>{{end}}
{{if can .Role "legalization.process"}}<a class="dropdown-item" href="/legalisasi">✅ Register Baru</a>{{end}}
{{if can .Role "finance.manage"}}<a class="dropdown-item" href="/finance">💰 Invoice Baru</a>{{end}}
</div>
</div>
<a class="btn btn-ghost-secondary" href="/tasks" title="Tugas" aria-label="Daftar tugas">☰</a>
<div class="dropdown">
<a href="#" class="btn btn-ghost-secondary position-relative" data-bs-toggle="dropdown" title="Notifikasi" aria-label="Notifikasi" aria-haspopup="true">🔔{{if .Unread}}<span class="badge bg-red position-absolute top-0 start-100 translate-middle">{{.Unread}}</span>{{end}}</a>
<div class="dropdown-menu dropdown-menu-end" style="width:320px">
<div class="dropdown-header">Notifikasi</div>
{{range .TopNotifs}}<div class="dropdown-item-text"><div>{{.Title}}</div><div class="small text-secondary">{{.Body}}</div></div>
{{else}}<div class="dropdown-item-text text-secondary">Tidak ada notifikasi.</div>{{end}}
<div class="dropdown-divider"></div>
<form method="post" action="/notifications/read" class="px-3 pb-2">{{template "csrf" .}}<button class="btn btn-sm btn-ghost-secondary w-100" type="submit">Tandai semua dibaca</button></form>
</div>
</div>
<div class="dropdown">
<a href="#" class="d-flex align-items-center gap-2 text-decoration-none text-body" data-bs-toggle="dropdown"><span class="avatar avatar-rounded">{{if .UserName}}{{slice .UserName 0 1}}{{else}}?{{end}}</span><span class="d-none d-md-block"><strong>{{.UserName}}</strong><br/><span class="small text-secondary">{{.Role}}</span></span></a>
<div class="dropdown-menu dropdown-menu-end">
<a class="dropdown-item" href="/mfa">Keamanan (MFA)</a>
<a class="dropdown-item" href="/office">Profil Kantor</a>
<div class="dropdown-divider"></div>
<form method="post" action="/logout">{{template "csrf" .}}<button class="dropdown-item text-danger" type="submit">Keluar</button></form>
</div>
</div>
</div></header>
<div class="page-header d-print-none"><div class="container-xl"><h2 class="page-title">{{.Title}}</h2></div></div>
<main class="page-body" id="konten"><div class="container-xl">
{{template "flash" .}}{{end}}

{{define "page_close"}}</div></main>
</div>
</div>
<script src="/assets/vendor/tabler.min.js"></script>
<script>
(function(){var p=location.pathname;document.querySelectorAll('#mainnav a.nav-link').forEach(function(a){var h=a.getAttribute('href');if(h&&h!=='#'&&(p===h||(h!=='/'&&p.indexOf(h)===0))){a.style.background='#c9a844';a.style.color='#101f3c';a.style.borderRadius='8px';a.style.fontWeight='700';}});})();
</script>
</body>
</html>{{end}}
