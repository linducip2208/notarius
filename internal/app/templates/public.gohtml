{{define "pub_head"}}<!doctype html>
<html lang="{{if .Data.Lang}}{{.Data.Lang}}{{else}}id{{end}}">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{{.Title}} — {{.Data.Brand.AppName}}</title>
{{if .Data.SEODesc}}<meta name="description" content="{{.Data.SEODesc}}"/>{{else if .Data.Site.SiteDesc}}<meta name="description" content="{{.Data.Site.SiteDesc}}"/>{{end}}
<meta property="og:title" content="{{.Title}} — {{.Data.Brand.AppName}}"/>
{{if .Data.OG}}<meta property="og:image" content="{{.Data.OG}}"/>{{end}}
{{if .Data.Office.Name}}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Notary","name":"{{.Data.Office.Name}}","address":"{{.Data.Office.Addr}}","telephone":"{{.Data.Office.Phone}}","email":"{{.Data.Office.Email}}"}</script>{{end}}
<link rel="icon" type="image/png" href="{{if .Data.Brand.FaviconURL}}{{.Data.Brand.FaviconURL}}{{else}}/assets/brand/favicon.svg{{end}}"/>
<style>
:root{--pri:{{.Data.Brand.Primary}};--sec:{{.Data.Brand.Secondary}};--acc:{{.Data.Brand.Accent}};--rad:{{.Data.Brand.ButtonRadius}}}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:{{css .Data.Brand.FontStack}};color:#1c2533;line-height:1.7;background:#fff;-webkit-font-smoothing:antialiased}
a{color:var(--pri);text-decoration:none}a:hover{text-decoration:underline}.wrap{width:100%;max-width:1140px;margin:0 auto;padding:0 24px}
.site-header{position:sticky;top:0;z-index:50;background:rgba(16,31,60,.96);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,255,255,.08)}
.header-inner{display:flex;align-items:center;gap:18px;min-height:66px}.brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:800;font-size:1.05rem;letter-spacing:.2px}.brand:hover{text-decoration:none}.brand img{width:34px;height:34px;object-fit:cover;border-radius:9px}
.navlinks{display:flex;gap:2px;margin-left:auto;flex-wrap:wrap}.navlink{color:rgba(255,255,255,.82);padding:8px 11px;border-radius:8px;font-size:.9rem}.navlink:hover{background:rgba(255,255,255,.12);color:#fff;text-decoration:none}
.header-actions{display:flex;gap:8px;align-items:center}.pill{display:inline-flex;align-items:center;gap:6px;padding:7px 12px;border-radius:999px;border:1px solid rgba(255,255,255,.25);color:#fff;font-size:.82rem;font-weight:600}.pill:hover{background:rgba(255,255,255,.12);text-decoration:none}
.btn{display:inline-flex;align-items:center;justify-content:center;background:var(--pri);color:#101c33 !important;text-decoration:none;padding:13px 26px;border-radius:var(--rad);font-weight:800;border:0;line-height:1.2;box-shadow:0 8px 20px rgba(201,162,39,.25)}.btn:hover{text-decoration:none;filter:brightness(1.05)}.btn.ghost{background:transparent;border:2px solid var(--pri);color:var(--pri) !important;box-shadow:none}.btn.light{background:var(--pri);color:#101c33 !important;box-shadow:none}.btn.small{padding:9px 16px;font-size:.88rem}
.btn-outline{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border:1.5px solid rgba(15,30,61,.25);border-radius:var(--rad);font-weight:700;color:#1c2533;background:#fff}.btn-outline:hover{text-decoration:none;border-color:var(--pri)}
.trust{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;background:#fff;border-radius:14px;padding:22px 18px;box-shadow:0 16px 40px rgba(16,31,60,.08);margin-top:16px;position:relative;z-index:3}.trust-item{text-align:center;font-size:.82rem;font-weight:700;color:#33405a;display:flex;flex-direction:column;align-items:center;gap:8px}.trust-item .ti{width:40px;height:40px;border-radius:11px;background:rgba(201,162,39,.14);color:#b38612;display:flex;align-items:center;justify-content:center;font-size:1.1rem}
.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.feature-card{background:#fff;border:1px solid #e8ecf3;border-radius:13px;padding:22px 18px;min-height:148px}.feature-card .fi{width:42px;height:42px;border-radius:11px;background:rgba(201,162,39,.14);color:#b38612;display:flex;align-items:center;justify-content:center;font-size:1.2rem;margin-bottom:12px}.feature-card h3{font-size:.98rem;margin:0 0 5px}.feature-card p{font-size:.86rem;color:#667085;margin:0;line-height:1.55}
.dark-cta{background:linear-gradient(115deg,#0f1e3d,#17315c);color:#fff;border-radius:18px;padding:42px;display:grid;grid-template-columns:1fr .9fr;gap:28px;align-items:center;overflow:hidden}.dark-cta h2{font-size:1.8rem;margin:0 0 8px}.dark-cta p{color:rgba(255,255,255,.78);margin:0 0 20px}.dark-cta img{width:100%;border-radius:12px;box-shadow:0 20px 44px rgba(0,0,0,.35)}
.eyebrow{display:inline-block;color:var(--acc);font-weight:800;letter-spacing:.14em;text-transform:uppercase;font-size:.72rem;margin-bottom:8px}
.hero{position:relative;overflow:hidden;color:#fff;background:radial-gradient(900px 420px at 85% 10%,rgba(201,168,68,.28),transparent 60%),linear-gradient(135deg,#101f3c 0%,#1b3358 55%,#24456f 100%);padding:74px 0 66px}
.hero:after{content:"";position:absolute;right:-80px;bottom:-160px;width:420px;height:420px;border:1px solid rgba(255,255,255,.08);border-radius:50%;pointer-events:none}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}.hero h1{font-size:2.9rem;line-height:1.15;margin:0 0 16px;letter-spacing:-.02em}.hero .lede{font-size:1.08rem;color:rgba(255,255,255,.86);max-width:520px;margin:0 0 22px}.hero .mini{margin-top:20px;color:rgba(255,255,255,.7);font-size:.9rem;display:flex;gap:16px;flex-wrap:wrap}
.hero-visual{position:relative}.hero-visual:before{content:"";position:absolute;inset:-14px -14px 14px 14px;border:1px solid rgba(201,168,68,.45);border-radius:20px;z-index:0}.hero-visual img{position:relative;z-index:1;width:100%;border-radius:18px;box-shadow:0 28px 60px rgba(0,0,0,.38);display:block}
.section{padding:72px 0}.section.muted{background:#f5f7fa}.section.tint{background:linear-gradient(180deg,#fff,#f9fafc)}.section-head{max-width:650px;margin-bottom:34px}.section h2{font-size:2rem;line-height:1.25;margin:4px 0 12px;letter-spacing:-.015em}.section p.lead{font-size:1.02rem;color:#536174;margin:0}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:20px}.card{background:#fff;border:1px solid #e6ebf2;border-radius:14px;padding:24px;box-shadow:0 2px 4px rgba(16,31,60,.02)}.card:hover{box-shadow:0 14px 30px rgba(16,31,60,.08);transform:translateY(-2px);transition:.18s ease}
.service-card{overflow:hidden;padding:0;display:flex;flex-direction:column}.service-img{width:100%;height:132px;object-fit:cover;background:#eef2f7}.service-body{padding:20px;display:flex;flex-direction:column;gap:6px;flex:1}.service-body h3{margin:0;font-size:1.1rem}.service-body p{margin:0;color:#64748b;font-size:.92rem}.service-body .btn{margin-top:auto;align-self:flex-start}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px;counter-reset:step}.step{position:relative;background:#fff;border:1px solid #e6ebf2;border-radius:12px;padding:22px 20px 20px 62px}.step:before{counter-increment:step;content:counter(step);position:absolute;left:18px;top:20px;width:30px;height:30px;border-radius:9px;background:rgba(31,111,235,.1);color:var(--pri);font-weight:800;display:flex;align-items:center;justify-content:center}.step strong{display:block;margin-bottom:3px}.step span{font-size:.9rem;color:#64748b}
.cta-band{background:linear-gradient(115deg,#0f1e3d,#17315c);color:#fff;border-radius:18px;padding:44px;text-align:center}.cta-band h2{margin:0 0 8px;font-size:1.9rem}.cta-band p{margin:0 0 22px;color:rgba(255,255,255,.85)}
.hero-photo{background-image:url('/media/1');background-size:cover;background-position:center;position:relative}.hero-photo:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(16,31,60,.96) 0%,rgba(16,31,60,.82) 52%,rgba(16,31,60,.45) 100%)}.hero-photo .wrap{position:relative;z-index:2}.hero-photo .hero-inner{max-width:720px}.hero-photo h1{font-size:3.2rem}.hero-photo .btn-row{display:flex;gap:12px;flex-wrap:wrap;margin:24px 0 18px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.04)}.stat{padding:20px 12px;text-align:center;color:#fff}.stat + .stat{border-left:1px solid rgba(255,255,255,.14)}.stat b{display:block;font-size:1.65rem;color:var(--acc);line-height:1.1}.stat span{font-size:.8rem;color:rgba(255,255,255,.72)}
.features{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:24px}.feature{display:flex;gap:14px;align-items:flex-start}.feature .fi{flex:none;width:42px;height:42px;border-radius:12px;background:rgba(31,111,235,.1);color:var(--pri);display:flex;align-items:center;justify-content:center;font-weight:800}.feature h3{margin:1px 0 4px;font-size:1.02rem}.feature p{margin:0;color:#64748b;font-size:.92rem}
.site-footer{background:#0c1629;color:#b8c4d6;padding:54px 0 28px}.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px}.site-footer h4{color:#fff;margin:0 0 12px;font-size:1rem}.site-footer a{color:#b8c4d6;font-size:.92rem;display:block;padding:3px 0}.site-footer a:hover{color:#fff}.footer-bottom{border-top:1px solid rgba(255,255,255,.1);margin-top:36px;padding-top:18px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:.85rem}
.meta{font-size:.88rem;color:#7b8798}.tag{background:#eef2f7;border-radius:20px;padding:2px 12px;font-size:.8rem;display:inline-block;margin:2px}
input,textarea,select{font:inherit;padding:11px 13px;border:1px solid #cdd5e0;border-radius:9px;width:100%;background:#fff}input:focus,textarea:focus,select:focus{outline:3px solid rgba(31,111,235,.14);border-color:var(--pri)}
.faq details{border:1px solid #e6ebf2;border-radius:12px;padding:16px 20px;margin-bottom:10px;background:#fff}.faq summary{font-weight:700;cursor:pointer}.skip{position:absolute;left:-9999px}.skip:focus{left:8px;top:8px;background:#fff;padding:10px;z-index:99;border-radius:8px}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:28px}.hero h1{font-size:2.2rem}.footer-grid{grid-template-columns:1fr 1fr}}
@media(max-width:680px){.navlinks{display:none}.navlinks.open{display:flex;flex-direction:column;width:100%;background:#101f3c;padding:12px;margin-top:8px;border-radius:12px}.header-inner{flex-wrap:wrap}.burger{display:inline-flex}.hero{padding:52px 0}.section{padding:52px 0}.hero h1{font-size:1.9rem}.footer-grid{grid-template-columns:1fr}.cta-band{padding:28px 20px}}
.burger{display:none;background:none;border:1px solid rgba(255,255,255,.35);color:#fff;border-radius:8px;padding:7px 11px;font-size:1rem;margin-left:auto}
</style>
</head>{{end}}

{{define "pub_nav"}}<a class="skip" href="#isi">Lewati ke konten</a>
{{if .Data.Announcement}}<div style="background:#fff8c5;color:#1a2333;text-align:center;padding:8px 16px;font-size:.9rem">{{.Data.Announcement}}</div>{{end}}
{{if .Data.Maintenance}}{{if .Data.LoggedIn}}<div style="background:#ffebe9;color:#82071e;text-align:center;padding:8px 16px;font-size:.9rem">MODE PEMELIHARAAN aktif — pengunjung anonim melihat halaman 503. <a href="/cms/site">Matikan di Pengaturan Website</a></div>{{end}}{{end}}
<header class="site-header"><div class="wrap header-inner">
<a class="brand" href="/">{{if .Data.Brand.LogoURL}}<img src="{{.Data.Brand.LogoURL}}" alt=""/>{{end}}<span>{{.Data.Brand.AppName}}</span></a>
<button class="burger" type="button" aria-label="Buka menu" onclick="document.getElementById('mnav').classList.toggle('open')">☰</button>
<nav class="navlinks" id="mnav" aria-label="Navigasi utama">{{range .Data.Nav}}<a class="navlink" href="{{.URL}}"{{if .NewTab}} target="_blank" rel="noopener"{{end}}>{{.Label}}</a>{{end}}</nav>
<div class="header-actions"><a class="pill" href="/cari">Cari</a><a class="pill" href="?lang={{.Data.OtherLang}}">{{.Data.OtherLang}}</a></div>
</div></header>{{end}}

{{define "pub_foot"}}<footer class="site-footer"><div class="wrap">
<div class="footer-grid">
<div><h4>{{.Data.Brand.AppName}}</h4><p class="meta" style="margin:0 0 6px">{{.Data.Office.Addr}}</p><p class="meta" style="margin:0 0 6px">{{.Data.Office.Phone}} · {{.Data.Office.Email}}</p><p class="meta">Sistem administrasi notaris mandiri. Bukan PPAT dan bukan firma hukum.</p></div>
<div><h4>Navigasi</h4>{{range .Data.Nav}}<a href="{{.URL}}"{{if .NewTab}} target="_blank" rel="noopener"{{end}}>{{.Label}}</a>{{end}}</div>
<div><h4>Kantor</h4><p class="meta" style="margin-top:0">{{.Data.Office.Name}}</p><a href="/konsultasi">Konsultasi →</a><a href="/booking">Booking kunjungan →</a><a href="/privasi">Kebijakan privasi →</a></div>
</div>
<div class="footer-bottom"><span>{{if .Data.Brand.CopyrightText}}{{.Data.Brand.CopyrightText}}{{else}}© 2026 SaktiNotaris{{end}}</span><span>Dibuat untuk kerapian administrasi, bukan pengganti keputusan Notaris.</span></div>
</div></footer></body></html>{{end}}

{{define "pub_home"}}{{template "pub_head" .}}<body>{{template "pub_nav" .}}<main id="isi">
{{if .Data.HasCMS}}
<section class="hero hero-photo" style="padding:56px 0 76px"><div class="wrap hero-grid">
<div><span class="eyebrow" style="background:rgba(201,162,39,.18);padding:6px 12px;border-radius:999px;color:#f0d79a">Sistem Notaris Digital</span>
<h1 style="font-size:2.9rem">Solusi Digital untuk Kantor Notaris yang Profesional</h1>
<p class="lede">Kelola klien, buat akta, dan administrasi  notaris dengan rapi, aman, dan tercatat dalam satu sistem mandiri untuk satu kantor.</p>
<div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:22px"><a class="btn" href="/konsultasi">Mulai Sekarang →</a><a class="btn-outline" href="#fitur">Pelajari Fitur ↓</a></div>
</div>
<div class="hero-visual"><img src="/assets/landing/notarius-hero.png" alt="Notaris" loading="lazy"/></div>
</div>
<div class="wrap"><div class="trust">
<div class="trust-item"><span class="ti">◎</span>Manajemen Klien</div>
<div class="trust-item"><span class="ti">▤</span>Pembuatan Akta</div>
<div class="trust-item"><span class="ti">▦</span>Repertorium Digital</div>
<div class="trust-item"><span class="ti">◇</span>Keamanan Data</div>
<div class="trust-item"><span class="ti">☷</span>Portal Klien</div>
</div></div>
</section>

<section class="section" id="fitur"><div class="wrap" style="text-align:center"><span class="eyebrow">Fitur Unggulan</span><h2 style="font-size:2rem">Semua yang Anda butuhkan dalam satu platform</h2><p class="lead" style="margin:0 auto 30px">Dirancang untuk kerapian administrasi kantor notaris — bukan pengganti keputusan hukum Notaris.</p>
<div class="feature-grid" style="text-align:left">
<div class="feature-card"><div class="fi">◎</div><h3>Manajemen Klien</h3><p>Data klien, identitas, dan riwayat interaksi dalam satu tempat.</p></div>
<div class="feature-card"><div class="fi">▤</div><h3>Workflow Akta</h3><p>Draf berversi, review, dan pengesahan dengan catatan yang jelas.</p></div>
<div class="feature-card"><div class="fi">▦</div><h3>Repertorium & Protokol</h3><p>Penomoran aman, arsip protokol, dan pelacakan lokasi fisik.</p></div>
<div class="feature-card"><div class="fi">☷</div><h3>Portal Klien</h3><p>Klien melihat permohonan dan tagihannya sendiri, terisolasi.</p></div>
<div class="feature-card"><div class="fi">Rp</div><h3>Keuangan & Pembayaran</h3><p>Invoice, pembayaran, anggaran, dan rekonsiliasi bank.</p></div>
<div class="feature-card"><div class="fi">▥</div><h3>Laporan Lengkap</h3><p>Angka agregat langsung dari database, tanpa data fabrikasi.</p></div>
<div class="feature-card"><div class="fi">◇</div><h3>Keamanan Terjaga</h3><p>Akses per peran, NIK terenkripsi, dan jejak audit berantai.</p></div>
<div class="feature-card"><div class="fi">☼</div><h3>Dukungan Profesional</h3><p>Alur bantu staf bekerja rapi; keputusan tetap di tangan Notaris.</p></div>
</div></div></section>

<section class="section"><div class="wrap"><div class="dark-cta">
<div><span class="eyebrow">Satu kantor, satu sistem</span><h2>Tingkatkan Produktivitas Kantor Notaris Anda</h2><p>Kelola proses administratif harian dengan rapi. Fokus Anda tetap pada pelayanan hukum dan ketelitian naskah.</p><a class="btn" href="/konsultasi">Mulai Sekarang →</a></div>
<img src="{{index .Data.ServiceImages 0}}" alt="Sistem notaris" loading="lazy"/>
</div></div></section>

{{range .Data.Sections}}{{template "pub_sec" .}}{{end}}
{{if .Data.Stats}}<section class="hero" style="padding:0"><div class="stats">
<div class="stat"><b>{{.Data.Stats.Services}}</b><span>Layanan resmi</span></div>
<div class="stat"><b>{{.Data.Stats.Articles}}</b><span>Artikel terbit</span></div>
<div class="stat"><b>{{.Data.Stats.FAQ}}</b><span>Tanya jawab</span></div>
</div></section>{{end}}
{{if .Data.CMSServices}}<section class="section" id="layanan"><div class="wrap"><div class="section-head"><span class="eyebrow">Ruang lingkup</span><h2>Layanan Kami</h2></div>
<div class="cards">{{range $idx, $svc := .Data.CMSServices}}<div class="card service-card">
<img class="service-img" src="{{index $.Data.ServiceImages $idx}}" alt="{{$svc.Name}}" loading="lazy"/>
<div class="service-body"><h3><a href="/layanan-kami/{{$svc.Slug}}">{{$svc.Name}}</a></h3><p>{{$svc.Description}}</p><a class="btn ghost small" href="/layanan-kami/{{$svc.Slug}}">Lihat detail →</a></div>
</div>{{end}}</div></div></section>{{end}}
{{else}}<section class="hero"><div class="wrap"><h1>{{.Data.Brand.AppName}}</h1><p class="lede">Website kantor dalam penyiapan. Kembali lagi segera.</p></div></section>{{end}}
</main>{{template "pub_foot" .}}{{end}}

{{define "pub_home_empty"}}{{template "pub_head" .}}<body>{{template "pub_nav" .}}<main id="isi">
<section class="hero"><div class="wrap"><h1>{{.Data.Brand.AppName}}</h1><p>Website kantor dalam penyiapan. Kembali lagi segera.</p><p><a class="btn" href="/layanan">Lihat layanan</a></p></div></section>
</main>{{template "pub_foot" .}}{{end}}

{{define "pub_sec"}}
{{if eq .Type "hero"}}<section class="hero hero-photo"><div class="wrap"><div class="hero-inner">
<span class="eyebrow" style="background:rgba(201,168,68,.18);padding:6px 12px;border-radius:999px;color:#f0d79a">{{.Subtitle}}</span>
<h1>{{.Title}}</h1>
<p class="lede">{{if .Content}}{{cmsHTML .Content}}{{else}}Kantor notaris untuk kebutuhan korporasi dan perdata.{{end}}</p>
<div class="btn-row"><a class="btn light" href="{{if .CTAURL}}{{.CTAURL}}{{else}}/konsultasi{{end}}">Konsultasi →</a><a class="pill" href="#layanan">Lihat layanan</a></div>
<div class="mini" style="font-size:.9rem"><span>✓ Identitas terverifikasi</span><span>✓ Proses tercatat</span><span>✓ Repertorium rapi</span></div>
</div></div></section>
{{else if eq .Type "cta"}}<section class="section"><div class="wrap"><div class="cta-band"><h2>{{.Title}}</h2><p>{{.Subtitle}}</p>{{if .CTALabel}}<a class="btn light" href="{{.CTAURL}}">{{.CTALabel}} →</a>{{end}}</div></div></section>
{{else if eq .Type "services"}}<section class="section {{.Background}}"><div class="wrap"><div class="section-head"><span class="eyebrow">{{.Subtitle}}</span><h2>{{.Title}}</h2></div><div class="cards">{{cmsHTML .Content}}</div>{{if .CTALabel}}<p><a class="btn ghost" href="{{.CTAURL}}">{{.CTALabel}} →</a></p>{{end}}</div></section>
{{else if eq .Type "process"}}<section class="section muted"><div class="wrap"><div class="section-head"><span class="eyebrow">{{.Subtitle}}</span><h2>{{.Title}}</h2><p class="lead">Tahapan administrasi yang tercatat. Tidak menggantikan tindakan hukum Notaris.</p></div><div class="steps"><div class="step"><strong>Konsultasi</strong><span>Pengecekan syarat dan kebutuhan.</span></div><div class="step"><strong>Verifikasi</strong><span>Identitas diperiksa oleh staf.</span></div><div class="step"><strong>Penyusunan</strong><span>Draf akta berversi dari template.</span></div><div class="step"><strong>Pengesahan</strong><span>Review dan tanda tangan Notaris.</span></div><div class="step"><strong>Pencatatan</strong><span>Repertorium dan pengarsipan.</span></div></div></div></section>
{{else}}<section class="section {{.Background}}"><div class="wrap"><div class="section-head"><span class="eyebrow">{{.Subtitle}}</span><h2>{{.Title}}</h2><div>{{cmsHTML .Content}}</div>{{if .CTALabel}}<p><a class="btn ghost" href="{{.CTAURL}}">{{.CTALabel}} →</a></p>{{end}}</div></div></section>{{end}}
{{end}}

{{define "pub_page"}}{{template "pub_head" .}}<body>{{template "pub_nav" .}}<main id="isi">
<section class="sec"><div class="wrap"><h1 style="font-size:2.1rem">{{.Data.Page.Title}}</h1><p class="meta">{{.Data.Page.Excerpt}}</p><div>{{cmsHTML .Data.Page.Content}}</div>
{{range .Data.Sections}}{{template "pub_sec" .}}{{end}}
</div></section>
</main>{{template "pub_foot" .}}{{end}}

{{define "pub_articles"}}{{template "pub_head" .}}<body>{{template "pub_nav" .}}<main id="isi">
<section class="sec"><div class="wrap"><h1>Artikel</h1>
<form method="get" action="/artikel" style="max-width:420px;display:flex;gap:8px;margin-bottom:22px"><input name="q" value="{{.Data.Q}}" placeholder="Cari artikel…"/><button class="btn" type="submit">Cari</button></form>
<div class="cards">{{range .Data.List}}<div class="card"><h3 style="margin-top:0"><a href="/artikel/{{.Slug}}">{{.Title}}</a></h3><p class="meta">{{.Excerpt}}</p><p class="meta">{{.Author}}</p></div>{{else}}<p class="meta">Belum ada artikel terbit.</p>{{end}}</div>
<p class="meta">Halaman {{.Data.Page}} dari {{.Data.Pages}} · total {{.Data.Total}}</p>
</div></section>
</main>{{template "pub_foot" .}}{{end}}

{{define "pub_article"}}{{template "pub_head" .}}<body>{{template "pub_nav" .}}<main id="isi">
<section class="sec"><div class="wrap" style="max-width:760px"><h1>{{.Data.Article.Title}}</h1>
<p class="meta">{{.Data.Article.Author}} · {{range .Data.Related}}{{end}}</p>
<div>{{cmsHTML .Data.Article.Content}}</div>
{{if .Data.Related}}<h3>Terkait</h3><div class="cards">{{range .Data.Related}}<div class="card"><a href="/artikel/{{.Slug}}">{{.Title}}</a></div>{{end}}</div>{{end}}
</div></section>
</main>{{template "pub_foot" .}}{{end}}

{{define "pub_faq"}}{{template "pub_head" .}}<body>{{template "pub_nav" .}}<main id="isi">
<section class="sec"><div class="wrap faq" style="max-width:760px"><h1>Tanya Jawab</h1>
{{range .Data.Groups}}<h2>{{.Name}}</h2>{{range .Items}}<details><summary>{{.Question}}</summary><div>{{cmsHTML .Answer}}</div></details>{{end}}{{else}}<p class="meta">Belum ada FAQ.</p>{{end}}
</div></section>
</main>{{template "pub_foot" .}}{{end}}

{{define "pub_contact"}}{{template "pub_head" .}}<body>{{template "pub_nav" .}}<main id="isi">
<section class="sec"><div class="wrap"><h1>Kontak</h1>
{{if .Data.HasPage}}<div>{{cmsHTML .Data.Page.Content}}</div>{{range .Data.Sections}}{{template "pub_sec" .}}{{end}}{{end}}
<div class="cards"><div class="card"><strong>{{.Data.Office.Name}}</strong><br/>{{.Data.Office.Addr}}<br/>{{.Data.Office.Phone}}<br/>{{.Data.Office.Email}}<br/>{{.Data.Office.Site}}</div>
<div class="card"><strong>Jam operasional</strong><br/>Senin–Jumat, 08.00–16.00 WIB<br/><span class="meta">Di luar jam kerja lewat WhatsApp/telepon.</span></div></div>
</div></section>
</main>{{template "pub_foot" .}}{{end}}

{{define "pub_about"}}{{template "pub_head" .}}<body>{{template "pub_nav" .}}<main id="isi">
<section class="sec"><div class="wrap" style="max-width:760px"><h1>Tentang Kami</h1>
{{if .Data.HasPage}}<div>{{cmsHTML .Data.Page.Content}}</div>{{range .Data.Sections}}{{template "pub_sec" .}}{{end}}{{end}}
<div class="card"><strong>{{.Data.Office.Name}}</strong><br/>{{.Data.Office.Addr}}<br/>{{.Data.Office.Phone}} · {{.Data.Office.Email}}<br/>{{.Data.Office.Site}}</div>
</div></section>
</main>{{template "pub_foot" .}}{{end}}

{{define "pub_services"}}{{template "pub_head" .}}<body>{{template "pub_nav" .}}<main id="isi">
<section class="sec"><div class="wrap"><h1>Layanan Kami</h1><p class="meta">Ruang lingkup jabatan Notaris. Bukan layanan PPAT/advokat.</p>
<div class="cards">{{range .Data.List}}<div class="card"><h3 style="margin-top:0"><a href="/layanan-kami/{{.Slug}}">{{.Name}}</a></h3><p class="meta">{{.Description}}</p></div>{{else}}<p class="meta">Belum ada info layanan.</p>{{end}}</div>
</div></section>
</main>{{template "pub_foot" .}}{{end}}

{{define "pub_service"}}{{template "pub_head" .}}<body>{{template "pub_nav" .}}<main id="isi">
<section class="sec"><div class="wrap" style="max-width:760px"><h1>{{.Data.Service.Name}}</h1><p class="meta">{{.Data.Service.Description}}</p><div>{{cmsHTML .Data.Service.Content}}</div>
{{if .Data.Service.ServiceCode}}<p><a class="btn" href="/layanan/{{.Data.Service.ServiceCode}}">Lihat Syarat &amp; Estimasi Biaya →</a></p>{{end}}
<p><a class="btn ghost" href="/konsultasi">Konsultasi →</a></p></div></section>
</main>{{template "pub_foot" .}}{{end}}
