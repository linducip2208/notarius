{{define "legalisasi"}}{{template "head" .}}{{template "page_open" .}}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Register Baru</h3></div>
<form method="post" action="/legalisasi">{{template "csrf" .}}<div class="card-body row">
<div class="col-md-2 mb-2"><select class="form-select" name="kind"><option value="LEGALISASI">Legalisasi</option><option value="WAARMERKING">Waarmerking</option><option value="SALINAN">Salinan</option><option value="KUTIPAN">Kutipan</option><option value="GROSSE">Grosse</option></select></div>
<div class="col-md-2 mb-2"><input class="form-control" name="register_no" placeholder="No. register" required/></div>
<div class="col-md-2 mb-2"><select class="form-select" name="client_id" required><option value="">— Klien —</option>{{range .Data.Clients}}<option value="{{.ID}}">{{.FullName}}</option>{{end}}</select></div>
<div class="col-md-2 mb-2"><select class="form-select" name="deed_id"><option value="">Minuta: —</option>{{range .Data.Deeds}}<option value="{{.ID}}">#{{.ID}} {{.Title}}</option>{{end}}</select></div>
<div class="col-md-2 mb-2"><input class="form-control" name="doc_title" placeholder="Judul dokumen" required/></div>
<div class="col-md-1 mb-2"><input class="form-control" name="fee" placeholder="Biaya" value="0"/></div>
<div class="col-md-1 mb-2"><button class="btn btn-primary w-100" type="submit">Simpan</button></div>
</div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Buku Register (antrean: REGISTERED terlama dipanggil dulu)</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>Antre</th><th>Jenis</th><th>No. Register</th><th>Dokumen</th><th>Biaya</th><th>Status</th><th>Estimasi ambil</th><th>Serah</th></tr></thead>
<tbody>{{range .Data.Rows}}<tr>{{if eq .Status "REGISTERED"}}<td><span class="badge bg-yellow-lt">#{{.Queue}}</span></td>{{else}}<td class="text-secondary">—</td>{{end}}<td>{{.Kind}}</td><td>{{.Reg}}</td><td>{{.Title}}</td><td>{{.Fee}}</td><td><span class="badge bg-blue-lt">{{.Status}}</span></td><td class="text-secondary small">{{if eq .Status "REGISTERED"}}±2 hari kerja{{else}}—{{end}}</td><td><form method="post" action="/legalisasi/{{.ID}}/advance" class="d-flex gap-1">{{template "csrf" $}}<select class="form-select form-select-sm" name="to"><option value="COMPLETED">COMPLETED</option><option value="HANDED_OVER">HANDED_OVER</option></select><button class="btn btn-sm btn-outline-primary" type="submit">OK</button></form></td></tr>
{{else}}<tr><td colspan="8" class="text-center text-secondary py-4">Belum ada register.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "gov"}}{{template "head" .}}{{template "page_open" .}}
<div class="alert alert-info">Alur <strong>asistensi</strong>: data disiapkan di SaktiNotaris, pengisian dilakukan manual oleh staf berwenang di portal resmi, lalu bukti diarsipkan di sini. Tidak ada endpoint pemerintah yang diinventarisasi. Lihat <a href="/tariffs">daftar biaya resmi (PNBP/materai)</a>.</div>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Pengajuan Baru</h3></div>
<form method="post" action="/gov"><div class="card-body row">{{template "csrf" .}}
<div class="col-md-3 mb-2"><select class="form-select" name="channel"><option value="AHU">AHU</option><option value="OSS">OSS</option></select></div>
<div class="col-md-7 mb-2"><input class="form-control" name="reference" placeholder="Referensi (mis. PT Maju Jaya — pendirian)" required/></div>
<div class="col-md-2 mb-2"><button class="btn btn-primary w-100" type="submit">Buat</button></div>
</div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Pengajuan AHU / OSS</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>ID</th><th>Kanal</th><th>Referensi</th><th>Status</th><th>Bukti</th><th>Tindak Lanjut</th><th>Checklist</th><th>Ubah</th></tr></thead>
<tbody>{{range .Data.Subs}}{{$sid := .ID}}<tr><td>{{$sid}}</td><td>{{.Channel}}</td><td>{{.Reference}}<div class="small text-secondary">{{range $i, $c := .Checklist}}{{if $c.Done}}✓{{else}}○{{end}} {{$c.Label}}<form method="post" action="/gov/{{$sid}}/check" class="d-inline"><input type="hidden" name="csrf" value="{{$.CSRF}}"/><input type="hidden" name="index" value="{{$i}}"/><button class="btn btn-sm btn-ghost-primary py-0" type="submit">toggle</button></form><br/>{{end}}</div></td><td><span class="badge bg-yellow-lt">{{.Status}}</span></td><td>{{.ReceiptNo}}</td>
<td><form method="post" action="/gov/{{$sid}}/followup" class="d-flex gap-1">{{template "csrf" $}}<input class="form-control form-control-sm" type="date" name="follow_up" value="{{.FollowUp}}"/><button class="btn btn-sm btn-ghost-primary" type="submit" title="Tanggal tindak lanjut resi manual">OK</button></form></td>
<td><span class="text-secondary small">{{len .Checklist}} item</span></td>
<td><form method="post" action="/gov/{{.ID}}/advance" class="d-flex gap-1">{{template "csrf" $}}
<select class="form-select form-select-sm" name="to"><option value="READY">READY</option><option value="SUBMITTED">SUBMITTED</option><option value="ACCEPTED">ACCEPTED</option><option value="REJECTED">REJECTED</option></select>
<input class="form-control form-control-sm" name="receipt_no" placeholder="No. bukti"/>
<button class="btn btn-sm btn-primary" type="submit">OK</button></form></td></tr>
{{else}}<tr><td colspan="8" class="text-center text-secondary py-4">Belum ada pengajuan.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "finance"}}{{template "head" .}}{{template "page_open" .}}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/app">Dashboard</a></li><li class="breadcrumb-item active">Keuangan</li></ol></nav>
<div class="card mb-3"><div class="row g-0 align-items-center"><div class="col"><div class="card-body"><h3 class="card-title mb-1">Keuangan Kantor</h3><p class="text-secondary mb-0">Invoice multi-baris, pembayaran anti-overpay, piutang terpantau.</p></div></div><div class="col-auto d-none d-md-block"><img src="/assets/landing/notarius-feat-keuangan.jpg" alt="Keuangan kantor" style="object-fit:cover;height:110px;width:220px;border-radius:0 8px 8px 0"/></div></div></div>
<div class="row row-deck row-cards mb-3">
<div class="col-sm-6"><div class="card"><div class="card-body"><div class="subheader">Piutang berjalan</div><div class="h1">Rp {{.Data.Outstanding}}</div></div></div></div>
<div class="col-sm-6"><div class="card"><div class="card-body"><div class="subheader">Penerimaan {{.Data.Month}}</div><div class="h1">Rp {{.Data.Revenue}}</div></div></div></div>
</div>
<p><a class="btn btn-ghost-primary" href="/finance/bank">Rekonsiliasi Bank →</a></p>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Invoice Baru</h3></div>
<form method="post" action="/invoices">{{template "csrf" .}}<input type="hidden" name="request_id" value="{{.Data.ReqID}}"/><div class="card-body">
{{if .Data.Suggest}}<div class="mb-2"><button type="button" class="btn btn-ghost-primary" id="fillTarifBtn" data-price="{{.Data.Suggest.Price}}" data-service="{{.Data.Suggest.ServiceName}}">⚡ Isi dari tarif layanan (Rp {{.Data.Suggest.Price}} — {{.Data.Suggest.ServiceName}})</button></div><script>(function(){var b=document.getElementById('fillTarifBtn');if(!b)return;b.addEventListener('click',function(){var svc=b.getAttribute('data-service')||'';var price=b.getAttribute('data-price')||'0';var descs=document.getElementsByName('desc[]');var qtys=document.getElementsByName('qty[]');var prices=document.getElementsByName('price[]');if(descs.length>0)descs[0].value='Jasa '+svc;if(prices.length>0)prices[0].value=price;if(qtys.length>0&&!qtys[0].value)qtys[0].value='1';if(descs.length>1)descs[1].value='PNBP / biaya resmi (diteruskan)';if(prices.length>1)prices[1].value='50000';if(qtys.length>1&&!qtys[1].value)qtys[1].value='1';if(descs.length>2)descs[2].value='Biaya materai & administrasi';if(prices.length>2)prices[2].value='20000';if(qtys.length>2&&!qtys[2].value)qtys[2].value='1';});})();</script>{{end}}
<div class="row"><div class="col-md-3 mb-2"><input class="form-control" name="number" placeholder="Nomor invoice" required/></div>
<div class="col-md-3 mb-2"><select class="form-select" name="client_id" required><option value="">— Klien —</option>{{range .Data.Clients}}<option value="{{.ID}}">{{.FullName}}</option>{{end}}</select></div>
<div class="col-md-3 mb-2"><input class="form-control" type="date" name="due_date"/></div>
<div class="col-md-3 mb-2"><select class="form-select" name="invoice_kind" title="Jenis invoice"><option value="FULL">FULL — pelunasan penuh</option><option value="DP">DP — uang muka</option><option value="PELUNASAN">PELUNASAN — sisa DP</option></select></div></div>
<div class="row"><div class="col-md-6 mb-2"><input class="form-control" name="desc[]" placeholder="Uraian baris 1"/></div>
<div class="col-md-3 mb-2"><input class="form-control" name="qty[]" placeholder="Qty" value="1"/></div>
<div class="col-md-3 mb-2"><input class="form-control" name="price[]" placeholder="Harga satuan" value="0"/></div></div>
<div class="row"><div class="col-md-6 mb-2"><input class="form-control" name="desc[]" placeholder="Uraian baris 2"/></div>
<div class="col-md-3 mb-2"><input class="form-control" name="qty[]" placeholder="Qty" value=""/></div>
<div class="col-md-3 mb-2"><input class="form-control" name="price[]" placeholder="Harga satuan" value=""/></div></div>
<div class="row"><div class="col-md-6 mb-2"><input class="form-control" name="desc[]" placeholder="Uraian baris 3"/></div>
<div class="col-md-3 mb-2"><input class="form-control" name="qty[]" placeholder="Qty" value=""/></div>
<div class="col-md-3 mb-2"><input class="form-control" name="price[]" placeholder="Harga satuan" value=""/></div></div>
<div class="text-end"><button class="btn btn-primary" type="submit">Terbitkan (PPN 11%)</button></div>
</div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Daftar Invoice</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>Nomor</th><th>Jenis</th><th>Total</th><th>Dibayar</th><th>Sisa</th><th>Progress</th><th>Status</th><th>Bayar</th></tr></thead>
<tbody>{{range .Data.Invoices}}<tr><td><a href="/invoices/{{.ID}}/receipt">{{.Number}}</a></td><td>{{if eq .Kind "DP"}}<span class="badge bg-yellow-lt">DP</span>{{else if eq .Kind "PELUNASAN"}}<span class="badge bg-purple-lt">PELUNASAN</span>{{else}}<span class="text-secondary small">FULL</span>{{end}}</td><td>{{.Total}}</td><td>{{.Paid}}</td><td>{{.Outstanding}}</td><td style="min-width:140px"><div class="small text-secondary mb-1">Rp {{.Paid}} / Rp {{.Total}} · {{.Pct}}%</div><div class="progress progress-sm"><div class="progress-bar bg-primary" style="width:{{.Pct}}%" role="progressbar" aria-valuenow="{{.Pct}}" aria-valuemin="0" aria-valuemax="100"></div></div></td><td><span class="badge bg-blue-lt">{{.Status}}</span>{{if .Overdue}} <span class="badge bg-red-lt">LEWAT {{.OverdueDays}} hari</span>{{end}}{{if .DueDate}}<div class="small text-secondary">Jt: {{.DueDate}}</div>{{end}}</td>
<td><div class="d-flex gap-1 flex-wrap">{{if or (eq .Status "PAID") (eq .Status "PARTIAL")}}<a class="btn btn-sm btn-ghost-primary" href="/invoices/{{.ID}}/receipt">Kuitansi</a>{{end}}<form method="post" action="/payments" class="d-flex gap-1 flex-wrap">{{template "csrf" $}}<input type="hidden" name="invoice_id" value="{{.ID}}"/><input class="form-control form-control-sm" name="amount" placeholder="Nominal"/><select class="form-select form-select-sm" name="method"><option value="TRANSFER">TRANSFER</option><option value="CASH">CASH</option><option value="QRIS">QRIS</option><option value="OTHER">OTHER</option></select><button class="btn btn-sm btn-primary" type="submit">Catat</button></form>{{if or (eq .Status "ISSUED") (eq .Status "PARTIAL")}}<form method="post" action="/invoices/{{.ID}}/void" class="d-flex gap-1 flex-wrap">{{template "csrf" $}}<input class="form-control form-control-sm" name="reason" placeholder="Alasan void" style="max-width:110px"/><button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Void invoice ini? Tidak dapat dibatalkan.')">Void</button></form>{{end}}</div></td></tr>
{{else}}<tr><td colspan="8" class="text-center text-secondary py-4">Belum ada invoice.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "templates"}}{{template "head" .}}{{template "page_open" .}}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Paket Template Konsep</h3><div class="ms-auto"><form method="post" action="/templates/seed">{{template "csrf" .}}<button class="btn btn-sm btn-success" type="submit" title="Pasang 8 template konsep (DRAFT). Wajib direview & Approve notaris sebelum dipakai draf.">⚡ Pasang 8 Konsep</button></form></div></div>
<div class="card-body"><p class="text-secondary small mb-0">Template konsep (PT, CV, AJB, Hibah, Kuasa, Sewa, Prenup, Perjanjian) — agar tombol 📄 Buat Draf Akta langsung menemukan template. Status DRAFT: <strong>tidak bisa</strong> dipakai draf sampai di-Approve.</p></div></div>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Kesiapan Jual per Layanan</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>Layanan</th><th class="text-end">Skor</th><th>Status</th><th>Checklist</th><th>Template ✓</th><th>Harga</th><th>Dipakai</th></tr></thead>
<tbody>{{range .Data.Readiness}}<tr><td><span class="text-secondary small">[{{.Cat}}]</span> {{.Name}}<div class="text-secondary small"><code>{{.Code}}</code></div></td><td class="text-end">{{.Score}}</td><td><span class="badge {{if eq .Status "SIAP JUAL"}}bg-green-lt{{else if eq .Status "KURANG"}}bg-yellow-lt{{else}}bg-red-lt{{end}}">{{.Status}}</span></td><td class="text-center">{{if .CL}}✓{{else}}—{{end}}</td><td class="small">{{if .TplOK}}✓ {{.Tpl}}{{else}}—{{end}}</td><td class="text-end">{{.Price}}</td><td class="text-end">{{.Used}}×</td></tr>
{{else}}<tr><td colspan="7" class="text-center text-secondary py-3">Belum ada layanan aktif.</td></tr>{{end}}</tbody></table></div>
<div class="card-body"><p class="text-secondary small mb-0">Skor = checklist 25 + template approved 40 + harga 15 + sudah dipakai 20. SIAP JUAL ≥ 80. Cara menaikkan: ⚡ Pasang di <a href="/dms/checklists">Checklist</a>, Approve template di bawah, isi tarif, buat 1 permohonan percobaan.</p></div></div>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Template Baru</h3></div>
<form method="post" action="/templates"><div class="card-body row">{{template "csrf" .}}
<div class="col-md-3 mb-2"><input class="form-control" name="name" placeholder="Nama template" required/></div>
<div class="col-md-2 mb-2"><input class="form-control" name="category" placeholder="Kategori" value="Umum"/></div>
<div class="col-md-5 mb-2"><input class="form-control" name="body" placeholder='Isi dengan {{"{{"}}nama{{"}}"}} …'/></div>
<div class="col-md-2 mb-2"><button class="btn btn-primary w-100" type="submit">Simpan</button></div>
</div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Template Dokumen</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>Nama</th><th>Kategori</th><th>Versi</th><th>Disetujui</th><th></th></tr></thead>
<tbody>{{range .Data.Templates}}<tr><td><a href="/templates/{{.ID}}">{{.Name}}</a></td><td>{{.Category}}</td><td>{{.Version}}</td><td>{{.Approved}}</td><td><a class="btn btn-sm btn-ghost-primary" href="/templates/{{.ID}}">Editor</a></td></tr>
{{else}}<tr><td colspan="5" class="text-center text-secondary py-4">Belum ada template. Template hanya berlaku setelah disetujui notaris.</td></tr>{{end}}</tbody></table></div></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Klausul Baku</h3></div>
<div class="card-body">{{range .Data.Clauses}}<div class="mb-2"><strong>{{.Title}}</strong> <span class="text-secondary">{{.Tags}} · approved={{.Approved}}</span></div>{{else}}<p class="text-secondary">Belum ada klausul.</p>{{end}}
<form method="post" action="/clauses" class="row">{{template "csrf" .}}
<div class="col-md-3 mb-2"><input class="form-control" name="title" placeholder="Judul klausul" required/></div>
<div class="col-md-5 mb-2"><input class="form-control" name="body" placeholder="Isi klausul" required/></div>
<div class="col-md-2 mb-2"><input class="form-control" name="tags" placeholder="tag1,tag2"/></div>
<div class="col-md-2 mb-2"><button class="btn btn-primary w-100" type="submit">Simpan</button></div></form></div></div>
{{template "page_close" .}}{{end}}

{{define "reports"}}{{template "head" .}}{{template "page_open" .}}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/app">Dashboard</a></li><li class="breadcrumb-item active">Laporan</li></ol></nav>
<div class="card mb-3"><div class="row g-0 align-items-center"><div class="col"><div class="card-body"><h3 class="card-title mb-1">Laporan Operasional</h3><p class="text-secondary mb-0">Angka real-time dari database — tanpa fabrikasi.</p></div></div><div class="col-auto d-none d-md-block"><img src="/assets/landing/notarius-feat-laporan.jpg" alt="Laporan bisnis" style="object-fit:cover;height:110px;width:220px;border-radius:0 8px 8px 0"/></div></div></div>
<div class="row row-deck row-cards">
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="subheader">Menunggu</div><div class="h1">{{.Data.Pending}}</div></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="subheader">Aktif</div><div class="h1">{{.Data.Active}}</div></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="subheader">Selesai</div><div class="h1">{{.Data.Completed}}</div></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="subheader">Piutang</div><div class="h1">Rp {{.Data.Outstanding}}</div></div></div></div>
</div>
<p class="text-secondary mt-3">Seluruh angka dihitung dari query database — tanpa data fabrikasi.</p>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Anggaran vs Realisasi ({{.Data.Month}})</h3><div class="ms-auto"><form method="post" action="/budgets" class="d-flex gap-1">{{template "csrf" $}}<input class="form-control form-control-sm" name="category" placeholder="Kategori" style="max-width:130px"/><input class="form-control form-control-sm" name="month" placeholder="YYYY-MM" style="max-width:100px"/><input class="form-control form-control-sm" name="amount" placeholder="Nominal" style="max-width:110px"/><button class="btn btn-sm btn-outline-primary" type="submit">Simpan</button></form></div></div>
<div class="table-responsive"><table class="table card-table"><thead><tr><th>Kategori</th><th class="text-end">Anggaran</th><th class="text-end">Realisasi</th><th class="text-end">Sisa</th></tr></thead>
<tbody>{{range .Data.Budgets}}<tr><td>{{.Category}}</td><td class="text-end">{{.Budget}}</td><td class="text-end">{{.Spent}}</td><td class="text-end">{{sub .Budget .Spent}}</td></tr>{{else}}<tr><td colspan="4" class="text-center text-secondary py-3">Belum ada anggaran bulan ini. Tambahkan lewat form di atas.</td></tr>{{end}}</tbody></table></div></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Pendapatan per Layanan</h3></div>
<div class="table-responsive"><table class="table card-table"><thead><tr><th>Layanan</th><th class="text-end">Invoice</th><th class="text-end">Total</th></tr></thead>
<tbody>{{range .Data.Profits}}<tr><td>{{.Service}}</td><td class="text-end">{{.Count}}</td><td class="text-end">{{.Total}}</td></tr>{{else}}<tr><td colspan="3" class="text-center text-secondary py-3">Belum ada data.</td></tr>{{end}}</tbody></table></div>
<p class="text-secondary small mx-3">Hanya invoice yang tertaut permohonan yang terpetakan ke layanan — tautkan invoice baru lewat halaman permohonan.</p></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Top 5 Layanan Bulan Ini ({{.Data.Month}})</h3></div>
<div class="table-responsive"><table class="table card-table"><thead><tr><th>Layanan</th><th class="text-end">Invoice</th><th class="text-end">Dibayar</th></tr></thead>
<tbody>{{range .Data.TopSvc}}<tr><td>{{.Service}}</td><td class="text-end">{{.Count}}</td><td class="text-end">{{.Paid}}</td></tr>{{else}}<tr><td colspan="3" class="text-center text-secondary py-3">Belum ada transaksi bulan ini.</td></tr>{{end}}</tbody></table></div></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Rekap per Kategori Layanan</h3></div>
<div class="table-responsive"><table class="table card-table"><thead><tr><th>Kategori</th><th class="text-end">Jml permohonan</th><th class="text-end">Total tagihan</th><th class="text-end">Sudah dibayar</th></tr></thead>
<tbody>{{range .Data.ByCat}}<tr><td>{{.Category}}</td><td class="text-end">{{.Reqs}}</td><td class="text-end">{{.InvTotal}}</td><td class="text-end">{{.Paid}}</td></tr>{{else}}<tr><td colspan="4" class="text-center text-secondary py-3">Belum ada data.</td></tr>{{end}}</tbody></table></div></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Melewati SLA</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>Permohonan</th><th>Layanan</th><th>Kode</th><th class="text-end">Umur (hari)</th><th class="text-end">SLA (hari)</th><th>Status</th></tr></thead>
<tbody>{{range .Data.SLAOver}}<tr><td><a href="/requests/{{.ID}}">#{{.ID}} {{.Title}}</a></td><td>{{.Service}}</td><td class="text-secondary small">{{.Code}}</td><td class="text-end">{{.AgeDays}}</td><td class="text-end">{{.SLADays}}</td><td><span class="badge bg-red-lt">{{.Status}}</span></td></tr>{{else}}<tr><td colspan="6" class="text-center text-secondary py-3">Tidak ada permohonan melewati SLA.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "settings"}}{{template "head" .}}{{template "page_open" .}}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/app">Dashboard</a></li><li class="breadcrumb-item active">Pengaturan</li></ol></nav>
<div class="card mb-3"><div class="row g-0 align-items-center"><div class="col"><div class="card-body"><h3 class="card-title mb-1">Pengaturan & Keamanan</h3><p class="text-secondary mb-0">Pengguna, peran, tautan portal klien, dan MFA TOTP.</p></div></div><div class="col-auto d-none d-md-block"><img src="/assets/landing/notarius-feat-keamanan.jpg" alt="Keamanan akun" style="object-fit:cover;height:110px;width:220px;border-radius:0 8px 8px 0"/></div></div></div>
<div class="card"><div class="card-header"><h3 class="card-title">Pengguna Kantor</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>Nama</th><th>Email</th><th>Peran</th><th>Aktif</th><th>Taut klien</th></tr></thead>
<tbody>{{range .Data.Users}}<tr><td>{{.Name}}</td><td>{{.Email}}</td><td>{{.Role}}</td><td>{{.IsActive}}</td>
<td><form method="post" action="/users/{{.ID}}/link" class="d-flex gap-1">{{template "csrf" $}}<input class="form-control form-control-sm" name="client_id" placeholder="ID klien"/><button class="btn btn-sm btn-ghost-primary" type="submit">Taut</button></form></td></tr>
{{else}}<tr><td colspan="5" class="text-center text-secondary py-4">Belum ada pengguna.</td></tr>{{end}}</tbody></table></div>
<div class="card-body border-top"><h4>Tambah Pengguna</h4>
<form method="post" action="/users" class="row">{{template "csrf" .}}
<div class="col-md-2 mb-2"><input class="form-control" name="name" placeholder="Nama" required/></div>
<div class="col-md-3 mb-2"><input class="form-control" type="email" name="email" placeholder="Email" required/></div>
<div class="col-md-2 mb-2"><input class="form-control" name="phone" placeholder="Telepon"/></div>
<div class="col-md-2 mb-2"><input class="form-control" type="password" name="password" placeholder="Kata sandi (min 8)" required/></div>
<div class="col-md-2 mb-2"><select class="form-select" name="role">{{range $.Data.Roles}}<option value="{{.}}">{{.}}</option>{{end}}</select></div>
<div class="col-md-1 mb-2"><button class="btn btn-primary w-100" type="submit">OK</button></div></form></div></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Peran tersedia</h3></div><div class="card-body">{{range .Data.Roles}}<span class="badge bg-azure-lt me-1">{{.}}</span>{{end}}</div></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Keamanan Akun</h3></div><div class="card-body"><a class="btn btn-outline-primary" href="/mfa">Aktifkan / Kelola MFA (TOTP)</a></div></div>
{{template "page_close" .}}{{end}}

{{define "wills"}}{{template "head" .}}{{template "page_open" .}}
<div class="alert alert-warning">Data wasiat bersifat <strong>terbatas</strong> — hanya notaris, notaris pengganti, dan auditor.</div>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Pendaftaran Wasiat</h3></div>
<form method="post" action="/wills"><div class="card-body row">{{template "csrf" .}}
<div class="col-md-5 mb-2"><select class="form-select" name="client_id" required><option value="">— Pewasiat —</option>{{range .Data.Clients}}<option value="{{.ID}}">{{.FullName}}</option>{{end}}</select></div>
<div class="col-md-5 mb-2"><input class="form-control" name="register_no" placeholder="Nomor register wasiat" required/></div>
<div class="col-md-2 mb-2"><button class="btn btn-primary w-100" type="submit">Daftar</button></div>
</div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Register Wasiat</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>ID</th><th>Klien</th><th>No. Register</th><th>Status</th><th>Review</th><th>Pembukaan</th><th>Serah-terima</th></tr></thead>
<tbody>{{range .Data.Wills}}<tr><td>{{.ID}}</td><td>{{.ClientID}}</td><td>{{.RegisterNo}}</td><td><span class="badge bg-yellow-lt">{{.Status}}</span></td>
<td>{{if .ReviewDate}}<span class="text-secondary small">{{.ReviewDate}}</span>{{else}}<form method="post" action="/wills/{{.ID}}/review">{{template "csrf" $}}<button class="btn btn-sm btn-ghost-primary" type="submit" title="Catat review tahunan hari ini">Review</button></form>{{end}}</td>
<td>{{if .OpenedAt}}<span class="badge bg-green-lt">dibuka</span> <span class="text-secondary small">{{.Witness}} · {{.OpenedAt}}</span>{{else}}<form method="post" action="/wills/{{.ID}}/open" class="d-flex gap-1">{{template "csrf" $}}<input class="form-control form-control-sm" name="witness" placeholder="Saksi pembuka" style="width:110px" required/><input class="form-control form-control-sm" name="note" placeholder="Berita acara" style="width:110px"/><button class="btn btn-sm btn-outline-warning" type="submit" onclick="return confirm('Catat pembukaan bersaksi?')">Buka</button></form>{{end}}</td>
<td><form method="post" action="/wills/{{.ID}}/handover" class="d-flex gap-1">{{template "csrf" $}}<input class="form-control form-control-sm" name="handed_to" placeholder="Diserahkan ke" style="width:100px"/><button class="btn btn-sm btn-outline-primary" type="submit">Serahkan</button></form></td></tr>
{{else}}<tr><td colspan="7" class="text-center text-secondary py-4">Belum ada wasiat terdaftar.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "portal"}}{{template "head" .}}{{template "page_open" .}}
<div class="card mb-3"><div class="row g-0 align-items-center"><div class="col"><div class="card-body"><h3 class="card-title mb-1">Portal Klien</h3><p class="text-secondary mb-0">Setiap akun hanya melihat datanya sendiri — penegakan server-side.</p></div></div><div class="col-auto d-none d-md-block"><img src="/assets/landing/notarius-feat-portal.jpg" alt="Portal klien" style="object-fit:cover;height:110px;width:220px;border-radius:0 8px 8px 0"/></div></div></div>
<div class="alert alert-info">Portal klien: setiap akun hanya dapat melihat dokumen dan permohonannya sendiri (penegakan di sisi server).</div>
<div class="mb-2"><a class="btn btn-outline-primary" href="/portal/invoices">Lihat Tagihan & Konfirmasi Bayar</a></div>
{{if .Data.Mine}}<div class="card mb-3"><div class="card-header"><h3 class="card-title">Permohonan Saya — Tracking Timeline</h3></div></div>
{{range .Data.Mine}}{{$st := .Step}}{{$fail := .Failed}}<div class="card mb-3"><div class="card-body">
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
<div><strong>#{{.ID}} {{.Title}}</strong></div>
<div class="d-flex gap-2 align-items-center flex-wrap">{{if eq .Status "COMPLETED"}}<span class="badge bg-green-lt">{{.Status}}</span>{{else if or (eq .Status "REJECTED") (eq .Status "CANCELLED")}}<span class="badge bg-red-lt">{{.Status}}</span>{{else if eq .Status "NEED_DOCS"}}<span class="badge bg-yellow-lt">{{.Status}}</span>{{else}}<span class="badge bg-blue-lt">{{.Status}}</span>{{end}}<span class="text-secondary small">{{.NextAction}}</span></div>
</div>
{{if $fail}}<div class="alert alert-danger py-2 mb-2">{{if eq .Status "REJECTED"}}Permohonan ditolak — {{.NextAction}}.{{else}}Permohonan dibatalkan.{{end}}</div>
{{else}}<div class="d-flex text-center mb-3">
<div style="flex:1"><div class="mx-auto mb-1 rounded-circle d-flex align-items-center justify-content-center" style="width:28px;height:28px;{{if ge $st 1}}background:#206bc4;color:#fff{{else}}background:#e9ecef;color:#868e96{{end}};font-weight:600">1</div><div class="small {{if eq $st 1}}fw-bold{{else}}text-secondary{{end}}">Diajukan</div></div>
<div style="flex:1"><div class="mx-auto mb-1 rounded-circle d-flex align-items-center justify-content-center" style="width:28px;height:28px;{{if ge $st 2}}background:#206bc4;color:#fff{{else}}background:#e9ecef;color:#868e96{{end}};font-weight:600">2</div><div class="small {{if eq $st 2}}fw-bold{{else}}text-secondary{{end}}">Dokumen</div></div>
<div style="flex:1"><div class="mx-auto mb-1 rounded-circle d-flex align-items-center justify-content-center" style="width:28px;height:28px;{{if ge $st 3}}background:#206bc4;color:#fff{{else}}background:#e9ecef;color:#868e96{{end}};font-weight:600">3</div><div class="small {{if eq $st 3}}fw-bold{{else}}text-secondary{{end}}">Review</div></div>
<div style="flex:1"><div class="mx-auto mb-1 rounded-circle d-flex align-items-center justify-content-center" style="width:28px;height:28px;{{if ge $st 4}}background:#206bc4;color:#fff{{else}}background:#e9ecef;color:#868e96{{end}};font-weight:600">4</div><div class="small {{if eq $st 4}}fw-bold{{else}}text-secondary{{end}}">Proses</div></div>
<div style="flex:1"><div class="mx-auto mb-1 rounded-circle d-flex align-items-center justify-content-center" style="width:28px;height:28px;{{if ge $st 5}}background:#2fb344;color:#fff{{else}}background:#e9ecef;color:#868e96{{end}};font-weight:600">5</div><div class="small {{if eq $st 5}}fw-bold{{else}}text-secondary{{end}}">Selesai</div></div>
</div>{{end}}
{{if .Timeline}}<div class="list-group list-group-flush border rounded mb-2">{{range .Timeline}}<div class="list-group-item small"><span class="badge bg-azure-lt">{{.From}} → {{.To}}</span> {{.Actor}} · {{.At}}{{if .Note}} — {{.Note}}{{end}}</div>{{end}}</div>{{else}}<p class="text-secondary small">Belum ada peristiwa tercatat.</p>{{end}}
<div class="d-flex gap-2 flex-wrap">
{{if or (eq .Status "NEED_DOCS") (eq .Status "DRAFT")}}<a class="btn btn-sm btn-warning" href="/requests/{{.ID}}">Lengkapi Dokumen</a>{{end}}
{{if and (eq .Status "COMPLETED") (.DeedID)}}<a class="btn btn-sm btn-primary" href="/deeds/{{.DeedID}}/pdf">Unduh PDF</a>{{end}}
<a class="btn btn-sm btn-outline-primary" href="/requests/{{.ID}}">Detail</a>
{{if or (eq .Status "REJECTED") (eq .Status "CANCELLED")}}<a class="btn btn-sm btn-outline-danger" href="/requests/{{.ID}}">Hubungi Kantor</a>{{end}}
</div>
</div></div>{{end}}
{{if .Data.Deeds}}<div class="card mt-3"><div class="card-header"><h3 class="card-title">Akta Saya</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>ID</th><th>Judul</th><th>Nomor</th><th>Status</th><th></th></tr></thead>
<tbody>{{range .Data.Deeds}}<tr><td>{{.ID}}</td><td>{{.Title}}</td><td>{{.Number}}</td><td><span class="badge bg-green-lt">{{.Status}}</span></td><td><a class="btn btn-sm btn-outline-primary" href="/deeds/{{.ID}}/pdf">Unduh PDF</a></td></tr>{{end}}</tbody></table></div></div>{{end}}
{{else if .Data.Requests}}<div class="card"><div class="card-header"><h3 class="card-title">Permohonan (staf)</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>ID</th><th>Judul</th><th>Klien</th><th>Status</th></tr></thead>
<tbody>{{range .Data.Requests}}<tr><td>{{.ID}}</td><td>{{.Title}}</td><td>{{.ClientName}}</td><td><span class="badge bg-blue-lt">{{.Status}}</span></td></tr>{{end}}</tbody></table></div></div>
{{else}}<div class="card"><div class="card-body"><p class="text-secondary">{{.Data.Note}}</p></div></div>{{end}}
{{template "page_close" .}}{{end}}
