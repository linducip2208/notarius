{{define "dashboard"}}{{template "head" .}}{{template "page_open" .}}
<div class="d-flex justify-content-between align-items-center mb-3">
<div><h2 class="page-title mb-0">Dashboard</h2><p class="text-secondary mb-0">Selamat datang, {{.UserName}}</p></div>
<form method="get" action="/appointments"><button class="btn btn-primary" type="submit">+ Jadwal Penghadap</button></form>
</div>
<div class="row row-deck row-cards mb-3">
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="d-flex align-items-center gap-2"><span class="avatar bg-blue-lt">👥</span><div><div class="subheader">Total Klien</div><div class="h1 mb-0">{{.Data.Clients}}</div></div></div><div class="small text-success mt-1">↑ {{.Data.DReq}}%</div><a href="/clients">Lihat klien</a></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="d-flex align-items-center gap-2"><span class="avatar bg-yellow-lt">📝</span><div><div class="subheader">Permohonan Layanan</div><div class="h1 mb-0">{{.Data.Pending}}</div></div></div><div class="small text-success mt-1">↑ {{.Data.DReq}}%</div><a href="/requests?status=SUBMITTED">Lihat antrean</a></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="d-flex align-items-center gap-2"><span class="avatar bg-green-lt">📜</span><div><div class="subheader">Akta Diterbitkan</div><div class="h1 mb-0">{{.Data.Completed}}</div></div></div><div class="small text-success mt-1">↑ {{.Data.DDeed}}%</div><a href="/deeds">Lihat akta</a></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="d-flex align-items-center gap-2"><span class="avatar bg-green-lt">💰</span><div><div class="subheader">Pendapatan Bulan Ini</div><div class="h1 mb-0">Rp {{.Data.Revenue}}</div></div></div><div class="small text-success mt-1">↑ {{.Data.DRev}}%</div><a href="/finance">Ke keuangan</a></div></div></div>
</div>
<div class="row g-3">
<div class="col-lg-8">
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Aktivitas 6 Bulan Terakhir</h3></div>
<div class="card-body">
<svg viewBox="0 0 600 180" style="width:100%;height:auto" role="img" aria-label="Grafik aktivitas">
<line x1="20" x2="580" y1="30" y2="30" stroke="#e7ebf2"/><line x1="20" x2="580" y1="70" y2="70" stroke="#e7ebf2"/><line x1="20" x2="580" y1="110" y2="110" stroke="#e7ebf2"/><line x1="20" x2="580" y1="150" y2="150" stroke="#e7ebf2"/>
<polyline points="{{.Data.ReqPts}}" fill="none" stroke="#206bc4" stroke-width="3" stroke-linejoin="round"/>
<polyline points="{{.Data.DeedPts}}" fill="none" stroke="#c9a844" stroke-width="3" stroke-linejoin="round"/>
</svg>
<div class="d-flex justify-content-between small text-secondary px-1">{{range .Data.Months}}<span>{{.}}</span>{{end}}</div>
<div class="d-flex gap-3 small mt-2"><span><span class="badge" style="background:#206bc4">&nbsp;</span> Permohonan</span><span><span class="badge" style="background:#c9a844">&nbsp;</span> Akta</span></div>
</div></div>
<div class="card"><div class="card-header"><h3 class="card-title">Agenda Hari Ini</h3><div class="ms-auto"><a href="/appointments">Lihat Semua →</a></div></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><tbody>
{{range .Data.Today}}<tr><td class="text-secondary">{{.At}}</td><td>{{.Purpose}} – {{.Client}}</td><td><span class="badge bg-blue-lt">{{.Status}}</span></td></tr>
{{else}}<tr><td class="text-center text-secondary py-3">Tidak ada jadwal hari ini. <a href="/appointments">Buat janji →</a></td></tr>{{end}}
</tbody></table></div></div>
</div>
<div class="col-lg-4">
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Jenis Layanan</h3></div>
<div class="card-body text-center">
{{if .Data.Donut}}<div class="mx-auto mb-2" style="width:140px;height:140px;border-radius:50%;background:{{.Data.Conic | css}}"></div>
<div class="d-flex flex-column gap-1 text-start">{{range .Data.Donut}}<div><span class="badge me-1" style="background:{{.Color}}">&nbsp;</span>{{.Label}} — {{.Pct}}%</div>{{end}}</div>
{{else}}<p class="text-secondary">Belum ada data layanan.</p>{{end}}
</div></div>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Notifikasi Terbaru</h3><div class="ms-auto"><form method="post" action="/notifications/read">{{template "csrf" .}}<button class="btn btn-sm btn-ghost-secondary" type="submit">Tandai dibaca</button></form></div></div>
<div class="list-group list-group-flush">{{range .Data.Notifs}}<div class="list-group-item"><div>🔔 {{.Title}}</div><div class="small text-secondary">{{.Body}}</div></div>
{{else}}<div class="list-group-item text-secondary">Belum ada notifikasi.</div>{{end}}</div></div>
<div class="card"><div class="card-header"><h3 class="card-title">Aktivitas Terbaru</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter">
<thead><tr><th>ID</th><th>Judul</th><th>Status</th><th></th></tr></thead>
<tbody>{{range .Data.Recent}}<tr><td>{{.ID}}</td><td>{{.Title}}</td><td><span class="badge bg-blue-lt">{{.Status}}</span></td>
<td><form method="post" action="/requests/{{.ID}}/move" class="d-inline">{{template "csrf" $}}<input type="hidden" name="to" value="IN_REVIEW"/><button class="btn btn-sm btn-ghost-secondary" type="submit">Proses</button></form></td></tr>
{{else}}<tr><td colspan="4" class="text-center text-secondary py-4">Belum ada permohonan. Buat dari halaman Permohonan.</td></tr>{{end}}</tbody>
</table></div></div>
</div>
</div>
{{template "page_close" .}}{{end}}
