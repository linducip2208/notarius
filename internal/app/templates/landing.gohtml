{{define "landing"}}<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content="NOTARIUS — Sistem Manajemen Kantor Notaris Indonesia. Kelola klien, akta, repertorium, protokol, dan keuangan dengan aman dan terintegrasi."/>
<meta property="og:title" content="NOTARIUS — Solusi Digital untuk Kantor Notaris"/>
<meta property="og:description" content="Kelola klien, buat akta, dan administrasi notaris dengan mudah, aman, dan terintegrasi."/>
<meta property="og:image" content="/assets/landing/notarius-hero.png"/>
<title>NOTARIUS — Solusi Digital untuk Kantor Notaris yang Profesional</title>
<link rel="stylesheet" href="/assets/vendor/tabler.min.css"/>
</head>
<body>
<header class="navbar navbar-expand-md bg-white border-bottom sticky-top">
<div class="container-xl">
<h1 class="navbar-brand navbar-brand-autodark"><span class="text-yellow fw-bold">N</span> NOTARIUS</h1>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navmenu"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="navmenu">
<div class="navbar-nav ms-auto align-items-center gap-1">
<a class="nav-link" href="#beranda">Beranda</a>
<a class="nav-link" href="#fitur">Fitur</a>
<a class="nav-link" href="#harga">Harga</a>
<a class="nav-link" href="#tentang">Tentang</a>
<a class="nav-link" href="#kontak">Kontak</a>
<a class="btn btn-outline-primary ms-2" href="/login">Masuk</a>
<a class="btn btn-warning ms-1" href="/login">Daftar</a>
</div>
</div>
</div>
</header>

<section id="beranda" class="py-5">
<div class="container-xl"><div class="row align-items-center g-5">
<div class="col-lg-6">
<h1 class="display-5 fw-bold">Solusi Digital untuk Kantor Notaris yang Profesional</h1>
<p class="text-secondary fs-3 mt-3">Kelola klien, buat akta, dan administrasi notaris dengan mudah, aman, dan terintegrasi.</p>
<div class="mt-4 d-flex gap-2 flex-wrap">
<a class="btn btn-warning btn-lg" href="/login">Mulai Sekarang →</a>
<a class="btn btn-outline-primary btn-lg" href="#fitur">Pelajari Fitur</a>
</div>
</div>
<div class="col-lg-6"><img class="img-fluid rounded shadow" style="object-fit:cover;width:100%;height:420px" src="/assets/landing/notarius-hero.png" alt="Meja kerja notaris: dokumen hukum, pena, timbangan keadilan"/></div>
</div></div>
</section>

<section class="py-4 border-top border-bottom"><div class="container-xl"><div class="row text-center g-3 small">
<div class="col-6 col-md"><strong class="d-block">👥 Manajemen Klien</strong><span class="text-secondary">Terintegrasi</span></div>
<div class="col-6 col-md"><strong class="d-block">📝 Pembuatan Akta</strong><span class="text-secondary">Lebih Mudah</span></div>
<div class="col-6 col-md"><strong class="d-block">📚 Repertorium & Protokol</strong><span class="text-secondary">Digital</span></div>
<div class="col-6 col-md"><strong class="d-block">🔒 Keamanan Data</strong><span class="text-secondary">Tingkat Tinggi</span></div>
<div class="col-6 col-md"><strong class="d-block">🤝 Portal Klien</strong><span class="text-secondary">Akses Terkendali</span></div>
</div></div></section>

<section id="fitur" class="py-5">
<div class="container-xl">
<div class="text-center mb-4"><h2 class="fw-bold">Fitur Unggulan</h2><p class="text-secondary">Semua yang Anda butuhkan dalam satu platform terpadu</p></div>
<div class="row g-3">
<div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="avatar avatar-lg bg-yellow-lt mb-3">👥</span><h4>Manajemen Klien</h4><p class="text-secondary">Perorangan & badan hukum, identitas terverifikasi manusia, beneficial owner.</p><a href="/login">Detail →</a></div></div></div>
<div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="avatar avatar-lg bg-yellow-lt mb-3">📝</span><h4>Workflow Akta</h4><p class="text-secondary">Draf berversi → review → pengesahan notaris → repertorium otomatis.</p><a href="/login">Detail →</a></div></div></div>
<div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="avatar avatar-lg bg-yellow-lt mb-3">📚</span><h4>Repertorium & Protokol</h4><p class="text-secondary">Pencatatan dan arsip digital, nomor unik per kantor, retensi 25 tahun.</p><a href="/login">Detail →</a></div></div></div>
<div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="avatar avatar-lg bg-yellow-lt mb-3">🤝</span><h4>Portal Klien</h4><p class="text-secondary">Pantau status permohonan, unduh dokumen — terisolasi per klien.</p><a href="/login">Detail →</a></div></div></div>
<div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="avatar avatar-lg bg-yellow-lt mb-3">💰</span><h4>Keuangan & Pembayaran</h4><p class="text-secondary">Invoice multi-baris, anti-kelebihan bayar, pengeluaran, tarif, piutang.</p><a href="/login">Detail →</a></div></div></div>
<div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="avatar avatar-lg bg-yellow-lt mb-3">📊</span><h4>Laporan Lengkap</h4><p class="text-secondary">Akta, repertorium, layanan, keuangan — dihitung dari data nyata.</p><a href="/login">Detail →</a></div></div></div>
<div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="avatar avatar-lg bg-yellow-lt mb-3">🔒</span><h4>Keamanan Terdepan</h4><p class="text-secondary">MFA TOTP, RBAC 9 peran, enkripsi NIK AES-256-GCM, audit imutabel.</p><a href="#keamanan">Detail →</a></div></div></div>
<div class="col-md-3"><div class="card h-100"><div class="card-body"><span class="avatar avatar-lg bg-yellow-lt mb-3">📁</span><h4>Document Management</h4><p class="text-secondary">Document center, upload privat, OCR terverifikasi, ekspor PDF & DOCX.</p><a href="/login">Detail →</a></div></div></div>
</div>
</div>
</section>

<section id="tentang" class="py-5 bg-light border-top border-bottom">
<div class="container-xl">
<div class="text-center mb-4"><h2 class="fw-bold">Lihat NOTARIUS Beraksi</h2><p class="text-secondary">Tampilan aplikasi yang benar-benar berjalan — masuk untuk mencoba langsung</p></div>
<div class="row g-3">
<div class="col-md-4"><div class="card"><img class="card-img-top" style="object-fit:cover;height:190px" src="/assets/landing/notarius-office.png" alt="Dashboard kantor"/><div class="card-body"><strong>Dashboard Kantor</strong><p class="text-secondary mb-2">Statistik real-time, agenda hari ini, notifikasi.</p><a href="/login" class="btn btn-sm btn-outline-primary">Buka Dashboard →</a></div></div></div>
<div class="col-md-4"><div class="card"><img class="card-img-top" style="object-fit:cover;height:190px" src="/assets/landing/notarius-hero.png" alt="Dokumen dan arsip"/><div class="card-body"><strong>Daftar Klien</strong><p class="text-secondary mb-2">Pencarian, filter jenis, deteksi duplikat, berkas privat.</p><a href="/login" class="btn btn-sm btn-outline-primary">Kelola Klien →</a></div></div></div>
<div class="col-md-4"><div class="card"><img class="card-img-top" style="object-fit:cover;height:190px" src="/assets/landing/notarius-sign.png" alt="Editor dan pengesahan akta"/><div class="card-body"><strong>Editor Akta</strong><p class="text-secondary mb-2">Template terapproved, riwayat versi, pengesahan + repertorium.</p><a href="/login" class="btn btn-sm btn-outline-primary">Buat Akta →</a></div></div></div>
</div>
</div>
</section>

<section class="py-5"><div class="container-xl"><div class="row g-5">
<div class="col-lg-6">
<h2 class="fw-bold">Alur Kerja Notaris</h2>
<p class="text-secondary">Tahapan manual tetap di tangan notaris — sistem mencatat dan mengarsipkan.</p>
<div class="list-group mt-3">
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">1</span><strong>Permohonan Klien</strong><span class="text-secondary"> — dicatat staf beserta persyaratan.</span></div>
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">2</span><strong>Pemeriksaan Persyaratan</strong><span class="text-secondary"> — kelengkapan berkas + verifikasi identitas.</span></div>
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">3</span><strong>Pembuatan Draft</strong><span class="text-secondary"> — dari template terapproved, revisi berversi.</span></div>
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">4</span><strong>Review & Persetujuan</strong><span class="text-secondary"> — hanya notaris yang dapat mengesahkan.</span></div>
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">5</span><strong>Finalisasi</strong><span class="text-secondary"> — draf terkunci, ekspor PDF/DOCX berwatermark.</span></div>
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">6</span><strong>Register & Arsip</strong><span class="text-secondary"> — repertorium otomatis, protokol, invoice.</span></div>
</div>
</div>
<div class="col-lg-6" id="keamanan">
<h2 class="fw-bold">Keamanan Berdasarkan Implementasi Aktual</h2>
<ul class="list-group mt-3">
<li class="list-group-item">🔐 Login bcrypt + sesi server-side + MFA TOTP dua langkah</li>
<li class="list-group-item">🛡️ RBAC 9 peran / 19 izin, penegakan di server + isolasi data per kantor</li>
<li class="list-group-item">🧬 NIK terenkripsi AES-256-GCM, tidak pernah tersimpan polos</li>
<li class="list-group-item">📜 Audit log imutabel untuk login, akta, keuangan, dan serah-terima</li>
<li class="list-group-item">🌐 Header HSTS + CSP ketat, CSRF semua form, rate-limit login</li>
</ul>
<p class="text-secondary small mt-2">Tanpa klaim sertifikasi — keamanan dibuktikan lewat uji, bukan janji.</p>
</div>
</div></div>
</section>

<section id="harga" class="py-5 bg-light border-top">
<div class="container-xl">
<div class="text-center mb-4"><h2 class="fw-bold">Harga</h2><p class="text-secondary">Pilih sesuai kebutuhan kantor Anda — hubungi kami untuk penawaran resmi</p></div>
<div class="row g-3">
<div class="col-md-4"><div class="card h-100"><div class="card-body"><h4>Kantor</h4><p class="display-6 fw-bold">Konsultasi</p><p class="text-secondary">Untuk kantor notaris tunggal. Seluruh modul operasional.</p><a href="#kontak" class="btn btn-outline-primary w-100">Minta Penawaran</a></div></div></div>
<div class="col-md-4"><div class="card h-100"><div class="ribbon bg-yellow">Populer</div><div class="card-body"><h4>Korporat</h4><p class="display-6 fw-bold">Konsultasi</p><p class="text-secondary">Multi-pengguna, portal klien, laporan lanjutan, prioritas dukungan.</p><a href="#kontak" class="btn btn-warning w-100">Minta Penawaran</a></div></div></div>
<div class="col-md-4"><div class="card h-100"><div class="card-body"><h4>Enterprise</h4><p class="display-6 fw-bold">Konsultasi</p><p class="text-secondary">On-premise, retensi arsip, SLA, audit keamanan khusus.</p><a href="#kontak" class="btn btn-outline-primary w-100">Hubungi Kami</a></div></div></div>
</div>
<p class="text-secondary small text-center mt-3">Harga final ditetapkan lewat penawaran resmi — tidak ada harga mengada-ada di halaman ini.</p>
</div>
</section>

<section class="py-5"><div class="container-xl" style="max-width:760px">
<h2 class="fw-bold text-center mb-4">Pertanyaan Umum</h2>
<div class="d-flex flex-column gap-2">
<div class="card"><div class="card-body"><details><summary class="fw-bold">Apakah NOTARIUS pengganti PPAT / advokat?</summary><p class="text-secondary mt-2 mb-0">Bukan. NOTARIUS hanya untuk layanan jabatan Notaris Indonesia, bukan PPAT maupun praktik advokat.</p></details></div></div>
<div class="card"><div class="card-body"><details><summary class="fw-bold">Apakah terhubung ke AHU/OSS resmi?</summary><p class="text-secondary mt-2 mb-0">Tidak ada API resmi yang diklaim. Modul AHU/OSS bersifat asistensi: checklist + pengarsipan bukti pengisian manual di portal resmi.</p></details></div></div>
<div class="card"><div class="card-body"><details><summary class="fw-bold">Bagaimana keamanan data NIK klien?</summary><p class="text-secondary mt-2 mb-0">NIK dienkripsi AES-256-GCM di sisi aplikasi; yang tampil hanya 4 digit terakhir. Hasil OCR tidak pernah dianggap terverifikasi — wajib verifikasi manusia.</p></details></div></div>
<div class="card"><div class="card-body"><details><summary class="fw-bold">Apakah bisa dipakai multi-kantor?</summary><p class="text-secondary mt-2 mb-0">Ya — seluruh data diisolasi per kantor di sisi server (office_id), bukan sekadar filter tampilan.</p></details></div></div>
<div class="card"><div class="card-body"><details><summary class="fw-bold">Bagaimana backup data?</summary><p class="text-secondary mt-2 mb-0">Skrip backup GPG + restore terdokumentasi di <code>deploy/</code>. Uji restore wajib sebelum produksi.</p></details></div></div>
</div>
</div></section>

<section class="bg-dark text-white py-5">
<div class="container-xl"><div class="row align-items-center g-5">
<div class="col-lg-6">
<h2 class="fw-bold">Kelola Kantor Notaris dengan Lebih Terstruktur</h2>
<p class="text-white-50">Fokus pada pelayanan hukum — kami yang mengurus teknologi.</p>
<a class="btn btn-warning btn-lg mt-2" href="/login">Mulai Sekarang →</a>
</div>
<div class="col-lg-6"><img class="img-fluid rounded shadow" style="object-fit:cover;width:100%;height:300px" src="/assets/landing/notarius-office.png" alt="Kantor notaris modern"/></div>
</div></div>
</section>

<footer id="kontak" class="py-4 border-top">
<div class="container-xl">
<div class="row g-3 small">
<div class="col-md-3"><strong>NOTARIUS</strong><p class="text-secondary">Digital. Profesional. Terpercaya.</p></div>
<div class="col-md-3"><strong>Produk</strong><div><a href="#fitur">Fitur</a></div><div><a href="#harga">Harga</a></div></div>
<div class="col-md-3"><strong>Perusahaan</strong><div><a href="#tentang">Tentang Kami</a></div><div><a href="#kontak">Kontak</a></div></div>
<div class="col-md-3"><strong>Bantuan</strong><div><a href="/login">Dokumentasi</a></div><div><a href="/login">Panduan</a></div></div>
</div>
<div class="d-flex justify-content-between text-secondary small mt-3 pt-3 border-top"><span>© 2026 NOTARIUS. Seluruh hak dilindungi.</span><span><a href="#beranda">Syarat & Ketentuan</a> · <a href="#beranda">Kebijakan Privasi</a></span></div>
</div>
</footer>
<script src="/assets/vendor/tabler.min.js"></script>
</body>
</html>{{end}}
