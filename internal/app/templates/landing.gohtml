<script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"SaktiNotaris","applicationCategory":"BusinessApplication","operatingSystem":"Web","description":"Sistem manajemen kantor Notaris Indonesia","offers":{"@type":"Offer","availability":"https://schema.org/PreOrder","priceCurrency":"IDR"}}</script>
<link rel="stylesheet" href="/assets/vendor/tabler.min.css"/>
</head>
<body>
<header class="navbar navbar-expand-md bg-white border-bottom sticky-top">
<div class="container-xl">
<h1 class="navbar-brand navbar-brand-autodark"><img src="/assets/brand/saktinotaris-logo-b.png" alt="SaktiNotaris" style="height:34px;width:34px;object-fit:cover;object-position:center;border-radius:8px;vertical-align:middle"/> SaktiNotaris</h1>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navmenu"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="navmenu">
<nav class="navbar-nav ms-auto align-items-center gap-1" aria-label="Navigasi utama">
