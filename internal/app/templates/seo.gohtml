{{define "layanan_index"}}<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Layanan Notaris — Pendirian PT, CV, Yayasan, Perjanjian, Wasiat | SaktiNotaris</title>
<meta name="description" content="Daftar layanan jabatan Notaris yang didukung SaktiNotaris: pendirian & perubahan PT/CV/Firma/Yayasan/Koperasi, perjanjian, kuasa, prenup, wasiat, legalisasi, asistensi AHU/OSS — beserta syarat dan alur."/>
<link rel="canonical" href="/layanan"/>
<meta property="og:title" content="Layanan Notaris yang Didukung SaktiNotaris"/>
<meta property="og:description" content="Syarat, alur, dan penawaran resmi per layanan kenotariatan."/>
<link rel="stylesheet" href="/assets/vendor/tabler.min.css"/>
</head>
<body>
<header class="navbar navbar-expand-md bg-white border-bottom sticky-top"><div class="container-xl">
<h1 class="navbar-brand"><a href="/" class="text-decoration-none text-body"><span class="text-yellow fw-bold">S</span> SaktiNotaris</a></h1>
<nav class="navbar-nav ms-auto flex-row gap-1 align-items-center" aria-label="Navigasi"><a class="nav-link" href="/">Beranda</a><a class="btn btn-outline-primary ms-2" href="/login">Masuk</a><a class="btn btn-warning ms-1" href="/login">Daftar</a></nav>
</div></header>
<main class="container-xl py-5">
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Beranda</a></li><li class="breadcrumb-item active">Layanan ({{.Total}})</li></ol></nav>
<h2 class="display-6 fw-bold">Layanan Jabatan Notaris</h2>
<p class="text-secondary">Setiap layanan di bawah ini tercatat di katalog resmi aplikasi beserta persyaratan dan alurnya. Klik untuk syarat dokumen, tahapan, dan cara meminta penawaran.</p>
{{range $cat := .Order}}<h3 class="mt-4 text-capitalize">{{$cat}}</h3>
<div class="row g-3">{{range index $.Groups $cat}}<div class="col-md-4"><div class="card h-100"><div class="card-body"><h4><a href="/layanan/{{.Code | lower}}">{{.Name}}</a></h4><p class="text-secondary small mb-2">Kode: {{.Code}}</p><a class="btn btn-sm btn-outline-primary" href="/layanan/{{.Code | lower}}">Syarat & Alur →</a></div></div></div>{{end}}</div>
{{end}}
<div class="alert alert-info mt-4">Harga final lewat penawaran resmi — <a href="/#harga">minta penawaran</a>. SaktiNotaris hanya untuk jabatan Notaris, bukan PPAT/advokat.</div>
</main>
<footer class="py-4 border-top"><div class="container-xl text-secondary small">© 2026 SaktiNotaris · <a href="/">Beranda</a></div></footer>
<script src="/assets/vendor/tabler.min.js"></script>
</body>
</html>{{end}}

{{define "layanan_detail"}}<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{{.Name}} — Syarat, Alur & Penawaran | SaktiNotaris</title>
<meta name="description" content="{{.Name}} ({{.Code}}): persyaratan dokumen, tahapan notaris, dan cara meminta penawaran resmi via SaktiNotaris."/>
<link rel="canonical" href="/layanan/{{.Code | lower}}"/>
<meta property="og:title" content="{{.Name}} — SaktiNotaris"/>
<meta property="og:description" content="Syarat dokumen, tahapan, dan penawaran resmi {{.Name}}."/>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"{{.Name}}","serviceType":"Layanan Notaris Indonesia","provider":{"@type":"Organization","name":"SaktiNotaris"},"areaServed":"ID"}}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Apa saja syarat {{.Name}}?","acceptedAnswer":{"@type":"Answer","text":"{{range .Reqs}}{{.}}; {{end}}"}},{"@type":"Question","name":"Bagaimana alurnya di SaktiNotaris?","acceptedAnswer":{"@type":"Answer","text":"Permohonan dicatat, persyaratan diperiksa, draf dibuat dari template terapproved, direview, disahkan notaris, lalu diregister dan diarsip."}}]}</script>
<link rel="stylesheet" href="/assets/vendor/tabler.min.css"/>
</head>
<body>
<header class="navbar navbar-expand-md bg-white border-bottom sticky-top"><div class="container-xl">
<h1 class="navbar-brand"><a href="/" class="text-decoration-none text-body"><span class="text-yellow fw-bold">S</span> SaktiNotaris</a></h1>
<nav class="navbar-nav ms-auto flex-row gap-1 align-items-center" aria-label="Navigasi"><a class="nav-link" href="/">Beranda</a><a class="nav-link" href="/layanan">Semua Layanan</a><a class="btn btn-warning ms-1" href="/login">Minta Penawaran</a></nav>
</div></header>
<main class="container-xl py-5" style="max-width:820px">
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/">Beranda</a></li><li class="breadcrumb-item"><a href="/layanan">Layanan</a></li><li class="breadcrumb-item active">{{.Name}}</li></ol></nav>
<p class="text-secondary mb-1">Layanan {{.Category}} · Kode {{.Code}}</p>
<h2 class="display-6 fw-bold">{{.Name}}</h2>
<div class="card mt-4"><div class="card-header"><h3 class="card-title">Persyaratan Dokumen</h3></div>
<ul class="list-group list-group-flush">{{range .Reqs}}<li class="list-group-item">✅ {{.}}</li>{{else}}<li class="list-group-item text-secondary">Hubungi kantor untuk daftar persyaratan layanan ini.</li>{{end}}</ul></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Tahapan di SaktiNotaris</h3></div>
<div class="list-group list-group-flush">
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">1</span>Permohonan dicatat beserta persyaratan</div>
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">2</span>Pemeriksaan kelengkapan + verifikasi identitas</div>
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">3</span>Draf dari template terapproved, revisi berversi</div>
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">4</span>Review & pengesahan notaris (final terkunci)</div>
<div class="list-group-item"><span class="badge bg-primary rounded-pill me-2">5</span>Register & arsip (repertorium/protokol/invoice)</div>
</div></div>
<div class="alert alert-warning mt-3"><strong>Harga:</strong> lewat penawaran resmi sesuai kebutuhan — <a href="/login">konsultasi sekarang</a>. Tanpa angka mengada-ada.</div>
<p><a href="/layanan">← Kembali ke semua layanan</a></p>
</main>
<footer class="py-4 border-top"><div class="container-xl text-secondary small">© 2026 SaktiNotaris · Bukan PPAT/advokat · Tanpa klaim API pemerintah.</div></footer>
<script src="/assets/vendor/tabler.min.js"></script>
</body>
</html>{{end}}
