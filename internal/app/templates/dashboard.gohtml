{{define "dashboard"}}{{template "head" .}}{{template "page_open" .}}
<div class="row row-deck row-cards">
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="subheader">Menunggu</div><div class="h1">{{.Data.Pending}}</div><a href="/requests?status=SUBMITTED">Lihat antrean</a></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="subheader">Aktif</div><div class="h1">{{.Data.Active}}</div><a href="/requests?status=IN_PROGRESS">Lihat pekerjaan</a></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="subheader">Selesai</div><div class="h1">{{.Data.Completed}}</div><a href="/requests?status=COMPLETED">Lihat riwayat</a></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card"><div class="card-body"><div class="subheader">Piutang</div><div class="h1">Rp {{.Data.Outstanding}}</div><a href="/finance">Ke keuangan</a></div></div></div>
</div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Aktivitas terbaru</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter">
<thead><tr><th>ID</th><th>Judul</th><th>Klien</th><th>Layanan</th><th>Status</th><th></th></tr></thead>
<tbody>{{range .Data.Recent}}<tr><td>{{.ID}}</td><td>{{.Title}}</td><td>{{.ClientName}}</td><td>{{.Service}}</td><td><span class="badge bg-blue-lt">{{.Status}}</span></td>
<td><form method="post" action="/requests/{{.ID}}/move" class="d-inline"><input type="hidden" name="to" value="IN_REVIEW"/><button class="btn btn-sm btn-ghost-primary" type="submit">Proses</button></form></td></tr>
{{else}}<tr><td colspan="6" class="text-center text-secondary py-4">Belum ada permohonan. Buat dari halaman Permohonan.</td></tr>{{end}}</tbody>
</table></div></div>
{{template "page_close" .}}{{end}}
