{{define "requests"}}{{template "head" .}}{{template "page_open" .}}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/app">Dashboard</a></li><li class="breadcrumb-item active">Permohonan Layanan</li></ol></nav>
{{if .Data.ClientName}}<div class="alert alert-info">Filter klien: <strong>{{.Data.ClientName}}</strong> <a href="/requests">✕ tampilkan semua</a></div>{{end}}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Permohonan Baru</h3></div>
<form method="post" action="/requests">{{template "csrf" .}}<div class="card-body row">
<div class="col-md-3 mb-2"><select class="form-select" name="client_id" required><option value="">— Klien —</option>{{range .Data.Clients}}<option value="{{.ID}}">{{.FullName}}</option>{{end}}</select></div>
<div class="col-md-3 mb-2"><select class="form-select" name="service_id" required><option value="">— Layanan —</option>{{range .Data.Services}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select></div>
<div class="col-md-3 mb-2"><input class="form-control" name="title" placeholder="Judul permohonan" required/></div>
<div class="col-md-2 mb-2"><input class="form-control" name="notes" placeholder="Catatan"/></div>
<div class="col-md-1 mb-2"><button class="btn btn-primary w-100" type="submit">Buat</button></div>
</div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Daftar Permohonan</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>ID</th><th>Judul</th><th>Klien</th><th>Layanan</th><th>Status</th><th>Aksi</th></tr></thead>
<tbody>{{range .Data.Requests}}<tr><td><a href="/requests/{{.ID}}">{{.ID}}</a></td><td><a href="/requests/{{.ID}}">{{.Title}}</a></td><td>{{.ClientName}}</td><td>{{.Service}}</td><td><span class="badge bg-blue-lt">{{.Status}}</span></td>
<td><form method="post" action="/requests/{{.ID}}/move" class="d-flex gap-1">{{template "csrf" $}}
<select class="form-select form-select-sm" name="to"><option value="SUBMITTED">SUBMITTED</option><option value="IN_REVIEW">IN_REVIEW</option><option value="NEED_DOCS">NEED_DOCS</option><option value="APPROVED">APPROVED</option><option value="IN_PROGRESS">IN_PROGRESS</option><option value="COMPLETED">COMPLETED</option><option value="REJECTED">REJECTED</option><option value="CANCELLED">CANCELLED</option></select>
<button class="btn btn-sm btn-primary" type="submit">OK</button></form></td></tr>
{{else}}<tr><td colspan="6" class="text-center text-secondary py-4">Belum ada permohonan.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "deeds"}}{{template "head" .}}{{template "page_open" .}}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/app">Dashboard</a></li><li class="breadcrumb-item active">Akta</li></ol></nav>
<div class="card mb-3"><div class="row g-0 align-items-center"><div class="col"><div class="card-body"><h3 class="card-title mb-1">Workflow Akta</h3><p class="text-secondary mb-0">Draf berversi dari template terapproved hingga pengesahan + repertorium.</p></div></div><div class="col-auto d-none d-md-block"><img src="/assets/landing/notarius-feat-akta.jpg" alt="Pengesahan akta" style="object-fit:cover;height:110px;width:220px;border-radius:0 8px 8px 0"/></div></div></div>
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Draf Akta Baru (dari template terapproved)</h3></div>
<form method="post" action="/deeds">{{template "csrf" .}}<div class="card-body row">
<div class="col-md-4 mb-2"><input class="form-control" name="title" placeholder="Judul akta" required/></div>
<div class="col-md-2 mb-2"><select class="form-select" name="kind"><option value="PT">PT</option><option value="CV">CV</option><option value="Yayasan">Yayasan</option><option value="Agreement">Perjanjian</option><option value="Will">Wasiat</option><option value="POA">Kuasa</option><option value="Prenup">Prenup/Postnup</option><option value="Other">Lainnya</option></select></div>
<div class="col-md-3 mb-2"><select class="form-select" name="template_id"><option value="">— Template (opsional) —</option>{{range .Data.Templates}}{{if .Approved}}<option value="{{.ID}}">{{.Name}} (v{{.Version}})</option>{{end}}{{end}}</select></div>
<div class="col-md-2 mb-2"><input class="form-control" name="request_id" placeholder="ID permohonan"/></div>
<div class="col-md-1 mb-2"><button class="btn btn-primary w-100" type="submit">Buat</button></div>
</div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Daftar Akta</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>ID</th><th>Nomor</th><th>Judul</th><th>Jenis</th><th>Status</th><th>Ver</th><th>Terkunci</th><th>Ekspor</th><th>Aksi</th></tr></thead>
<tbody>{{range .Data.Deeds}}<tr><td><a href="/deeds/{{.ID}}">{{.ID}}</a></td><td>{{.Number}}</td><td><a href="/deeds/{{.ID}}">{{.Title}}</a></td><td>{{.Kind}}</td><td><span class="badge bg-green-lt">{{.Status}}</span></td><td>{{.Version}}</td><td>{{.Locked}}</td><td><div class="d-flex gap-1"><a class="btn btn-sm btn-ghost-primary" href="/deeds/{{.ID}}/pdf">PDF</a><a class="btn btn-sm btn-ghost-primary" href="/deeds/{{.ID}}/docx">DOCX</a></div></td>
<td><div class="d-flex gap-1"><form method="post" action="/deeds/{{.ID}}/review">{{template "csrf" $}}<button class="btn btn-sm btn-outline-primary" type="submit" title="Kirim ke review notaris">Review</button></form><form method="post" action="/deeds/{{.ID}}/approve" class="d-flex gap-1">{{template "csrf" $}}<input class="form-control form-control-sm" name="number" placeholder="No. akta" style="width:90px"/><button class="btn btn-sm btn-success" type="submit" title="Setujui (notaris) + repertorium otomatis">Sahkan</button></form></div></td></tr>
{{else}}<tr><td colspan="9" class="text-center text-secondary py-4">Belum ada akta.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "repertorium"}}{{template "head" .}}{{template "page_open" .}}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/app">Dashboard</a></li><li class="breadcrumb-item active">Buku Repertorium</li></ol></nav>
<div class="card mb-3"><div class="row g-0 align-items-center"><div class="col"><div class="card-body"><h3 class="card-title mb-1">Repertorium Digital</h3><p class="text-secondary mb-0">Nomor unik per kantor, terisi otomatis saat akta disahkan.</p></div></div><div class="col-auto d-none d-md-block"><img src="/assets/landing/notarius-feat-repertorium.jpg" alt="Arsip repertorium" style="object-fit:cover;height:110px;width:220px;border-radius:0 8px 8px 0"/></div></div></div>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center"><h3 class="card-title">Buku Repertorium</h3><div class="d-flex gap-2 no-print"><a class="btn btn-outline-primary" href="/repertorium/export?year={{.Data.Year}}&month={{.Data.Month}}&q={{.Data.Q}}">Ekspor CSV</a><button class="btn btn-primary" type="button" onclick="window.print()">Cetak</button></div></div>
<form method="get" action="/repertorium"><div class="card-body border-bottom d-flex gap-2 flex-wrap no-print">
<input class="form-control" style="max-width:120px" name="year" placeholder="Tahun" value="{{.Data.Year}}"/>
<input class="form-control" style="max-width:120px" name="month" placeholder="Bulan" value="{{.Data.Month}}"/>
<input class="form-control" style="max-width:260px" type="search" name="q" placeholder="Cari nomor / uraian…" value="{{.Data.Q}}"/>
<button class="btn btn-primary" type="submit">Filter</button>
</div></form>
{{if .Data.Gaps}}<div class="alert alert-warning">Nomor lompat terdeteksi: {{range .Data.Gaps}}<span class="badge bg-yellow-lt me-1">{{.}}</span>{{end}}<span class="text-secondary small">— selidiki sebelum tutup tahun buku.</span></div>{{end}}
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>No</th><th>Tanggal</th><th>Uraian</th><th>Para pihak</th><th class="no-print">Label</th></tr></thead>
<tbody>{{range .Data.Rows}}<tr><td>{{.No}}</td><td>{{.Date}}</td><td>{{.Desc}}</td><td>{{.Parties}}</td><td class="no-print"><a class="btn btn-sm btn-ghost-primary" href="/qr?d=Repertorium+{{.No}}+{{.Date}}" target="_blank" title="Label QR untuk map fisik">QR</a></td></tr>
{{else}}<tr><td colspan="5" class="text-center text-secondary py-4">Belum ada entri repertorium. Nomor terisi otomatis saat akta disahkan.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "protocols"}}{{template "head" .}}{{template "page_open" .}}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Bendel Baru (25 tahun, UUJN)</h3></div>
<form method="post" action="/protocols"><div class="card-body row">{{template "csrf" .}}
<div class="col-md-3 mb-2"><input class="form-control" name="bundle_no" placeholder="No. bendel" required/></div>
<div class="col-md-3 mb-2"><input class="form-control" name="year" placeholder="Tahun" value="2026" required/></div>
<div class="col-md-4 mb-2"><input class="form-control" name="minuta_ref" placeholder="Referensi minuta"/></div>
<div class="col-md-2 mb-2"><button class="btn btn-primary w-100" type="submit">Catat</button></div>
</div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Arsip Protokol Notaris</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>Bendel</th><th>Tahun</th><th>Referensi minuta</th></tr></thead>
<tbody>{{range .Data}}<tr><td>{{.Bundle}}</td><td>{{.Year}}</td><td>{{.Ref}}</td></tr>
{{else}}<tr><td colspan="3" class="text-center text-secondary py-4">Belum ada bendel protokol.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}
