{{define "forbidden"}}{{template "head" .}}{{template "page_open" .}}
<div class="card"><div class="card-body text-center py-5">
<h1 class="display-6">403 — Akses Ditolak</h1>
<p class="text-secondary">Peran Anda ({{.Data.Role}}) tidak memiliki izin untuk halaman ini. Minta akses ke notaris/office admin bila memang membutuhkan.</p>
<a class="btn btn-primary" href="/">Kembali ke Dashboard</a>
</div></div>
{{template "page_close" .}}{{end}}

{{define "notfound"}}{{template "head" .}}{{template "page_open" .}}
<div class="card"><div class="card-body text-center py-5">
<h1 class="display-6">404 — Tidak Ditemukan</h1>
<p class="text-secondary">Jalur {{.Data.Path}} tidak ada atau telah dipindahkan.</p>
<a class="btn btn-primary" href="/">Kembali ke Dashboard</a>
</div></div>
{{template "page_close" .}}{{end}}

{{define "deed_detail"}}{{template "head" .}}{{template "page_open" .}}
<div class="row"><div class="col-md-7">
<div class="card"><div class="card-header"><h3 class="card-title">#{{.Data.Deed.ID}} — {{.Data.Deed.Title}}</h3></div>
<div class="card-body"><dl class="row">
<dt class="col-4">Nomor</dt><dd class="col-8">{{.Data.Deed.Number}}</dd>
<dt class="col-4">Jenis</dt><dd class="col-8">{{.Data.Deed.Kind}}</dd>
<dt class="col-4">Status</dt><dd class="col-8"><span class="badge bg-blue-lt">{{.Data.Deed.Status}}</span></dd>
<dt class="col-4">Versi</dt><dd class="col-8">{{.Data.Deed.Version}} · terkunci={{.Data.Deed.Locked}}</dd>
</dl>
<pre class="p-3 bg-light border rounded" style="white-space:pre-wrap">{{.Data.Body}}</pre>
<div class="d-flex gap-2 mt-3">
{{if .Data.CanApprove}}<form method="post" action="/deeds/{{.Data.Deed.ID}}/review">{{template "csrf" .}}<button class="btn btn-outline-primary" type="submit">Kirim Review</button></form>
<form method="post" action="/deeds/{{.Data.Deed.ID}}/approve" class="d-flex gap-1">{{template "csrf" .}}<input class="form-control" name="number" placeholder="No. akta" required/><button class="btn btn-success" type="submit" onclick="return confirm('Sahkan akta? Repertorium otomatis.')">Sahkan</button></form>{{end}}
<a class="btn btn-ghost-primary" href="/deeds/{{.Data.Deed.ID}}/pdf">PDF</a>
<a class="btn btn-ghost-primary" href="/deeds/{{.Data.Deed.ID}}/docx">DOCX</a>
</div></div></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Revisi Baru (terversi)</h3></div>
<form method="post" action="/deeds/{{.Data.Deed.ID}}/version"><div class="card-body">{{template "csrf" .}}
<textarea class="form-control mb-2" name="content" rows="6" placeholder="Isi revisi lengkap…">{{.Data.Body}}</textarea>
<input class="form-control mb-2" name="note" placeholder="Catatan revisi"/>
<button class="btn btn-primary" type="submit">Simpan Revisi</button>
<p class="text-secondary small mt-2">Final yang disahkan terkunci; perubahan setelahnya harus revisi tercatat baru.</p>
</div></form></div>
</div>
<div class="col-md-5"><div class="card"><div class="card-header"><h3 class="card-title">Riwayat Versi</h3></div>
<div class="card-body">{{range .Data.Versions}}<div class="mb-3 pb-2 border-bottom"><strong>v{{.No}}</strong> <span class="text-secondary">{{.CreatedAt}} · {{.Hash}}</span><div class="small">{{.Note}}</div><pre class="small p-2 bg-light border rounded" style="white-space:pre-wrap;max-height:160px;overflow:auto">{{.Content}}</pre></div>{{else}}<p class="text-secondary">Belum ada revisi tersimpan.</p>{{end}}</div></div>
</div></div>
{{template "page_close" .}}{{end}}

{{define "documents"}}{{template "head" .}}{{template "page_open" .}}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Document Center</h3></div>
<form method="get" action="/documents"><div class="card-body d-flex gap-2"><input class="form-control" name="q" placeholder="Cari nama berkas…" value="{{.Data.Q}}"/><button class="btn btn-primary" type="submit">Cari</button></div></form></div>
<div class="card"><div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>ID</th><th>Nama</th><th>Pemilik</th><th>MIME</th><th>Ukuran</th><th>OCR</th><th>Diunggah</th><th></th></tr></thead>
<tbody>{{range .Data.Docs}}<tr><td>{{.ID}}</td><td>{{.Name}}</td><td>{{.Owner}}/{{.OwnerID}}</td><td>{{.MIME}}</td><td>{{.Size}}</td><td>{{.OCR}}</td><td>{{.At}}</td><td><a class="btn btn-sm btn-outline-primary" href="/files/{{.ID}}">Unduh</a></td></tr>
{{else}}<tr><td colspan="8" class="text-center text-secondary py-4">Belum ada dokumen. Unggah dari halaman detail klien.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "audit"}}{{template "head" .}}{{template "page_open" .}}
<div class="card"><div class="card-header"><h3 class="card-title">Audit Log (imutabel)</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>ID</th><th>Aktor</th><th>Aksi</th><th>Entitas</th><th>ID Entitas</th><th>Waktu</th></tr></thead>
<tbody>{{range .Data}}<tr><td>{{.ID}}</td><td>{{.Actor}}</td><td>{{.Action}}</td><td>{{.Entity}}</td><td>{{.EntityID}}</td><td>{{.At}}</td></tr>
{{else}}<tr><td colspan="6" class="text-center text-secondary py-4">Belum ada aktivitas tercatat.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "office"}}{{template "head" .}}{{template "page_open" .}}
<div class="card"><div class="card-header"><h3 class="card-title">Profil Kantor</h3></div>
<form method="post" action="/office"><div class="card-body row">{{template "csrf" .}}
<div class="col-md-6 mb-2"><label class="form-label">Nama kantor</label><input class="form-control" name="name" value="{{.Data.Name}}" required/></div>
<div class="col-md-6 mb-2"><label class="form-label">Nama notaris</label><input class="form-control" name="notary" value="{{.Data.Notary}}" required/></div>
<div class="col-md-4 mb-2"><label class="form-label">No. SK</label><input class="form-control" name="sk" value="{{.Data.SK}}"/></div>
<div class="col-md-4 mb-2"><label class="form-label">Telepon</label><input class="form-control" name="phone" value="{{.Data.Phone}}"/></div>
<div class="col-md-4 mb-2"><label class="form-label">Email</label><input class="form-control" name="email" value="{{.Data.Email}}"/></div>
<div class="col-12 mb-2"><label class="form-label">Alamat</label><textarea class="form-control" name="address" rows="2">{{.Data.Address}}</textarea></div>
<div class="col-12 text-end"><button class="btn btn-primary" type="submit">Simpan</button></div>
</div></form></div>
{{template "page_close" .}}{{end}}

{{define "tasks"}}{{template "head" .}}{{template "page_open" .}}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Tugas Baru</h3></div>
<form method="post" action="/tasks"><div class="card-body row">{{template "csrf" .}}
<div class="col-md-7 mb-2"><input class="form-control" name="title" placeholder="Judul tugas" required/></div>
<div class="col-md-3 mb-2"><input class="form-control" type="date" name="due"/></div>
<div class="col-md-2 mb-2"><button class="btn btn-primary w-100" type="submit">Tambah</button></div>
</div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Daftar Tugas</h3></div>
<div class="table-responsive"><table class="table card-table"><thead><tr><th>ID</th><th>Judul</th><th>Tenggat</th><th>Status</th><th></th></tr></thead>
<tbody>{{range .Data}}<tr><td>{{.ID}}</td><td>{{.Title}}</td><td>{{.Due}}</td><td>{{.Status}}</td><td>{{if eq .Status "OPEN"}}<form method="post" action="/tasks/{{.ID}}/done">{{template "csrf" $}}<button class="btn btn-sm btn-success" type="submit">Selesai</button></form>{{end}}</td></tr>
{{else}}<tr><td colspan="5" class="text-center text-secondary py-4">Tidak ada tugas terbuka. Tambahkan di atas.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "expenses"}}{{template "head" .}}{{template "page_open" .}}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Catat Pengeluaran</h3></div>
<form method="post" action="/expenses"><div class="card-body row">{{template "csrf" .}}
<div class="col-md-3 mb-2"><input class="form-control" name="category" placeholder="Kategori" value="Operasional"/></div>
<div class="col-md-4 mb-2"><input class="form-control" name="description" placeholder="Uraian" required/></div>
<div class="col-md-2 mb-2"><input class="form-control" name="amount" placeholder="Nominal" required/></div>
<div class="col-md-2 mb-2"><input class="form-control" type="date" name="spent_at"/></div>
<div class="col-md-1 mb-2"><button class="btn btn-primary w-100" type="submit">OK</button></div>
</div></form></div>
<div class="card"><div class="table-responsive"><table class="table card-table"><thead><tr><th>ID</th><th>Kategori</th><th>Uraian</th><th>Nominal</th><th>Tanggal</th></tr></thead>
<tbody>{{range .Data}}<tr><td>{{.ID}}</td><td>{{.Cat}}</td><td>{{.Desc}}</td><td>{{.Amount}}</td><td>{{.At}}</td></tr>
{{else}}<tr><td colspan="5" class="text-center text-secondary py-4">Belum ada pengeluaran tercatat.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "tariffs"}}{{template "head" .}}{{template "page_open" .}}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Tarif Baru</h3></div>
<form method="post" action="/tariffs"><div class="card-body row">{{template "csrf" .}}
<div class="col-md-3 mb-2"><select class="form-select" name="service_id"><option value="">— Layanan —</option>{{range .Data.Services}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select></div>
<div class="col-md-5 mb-2"><input class="form-control" name="name" placeholder="Nama tarif" required/></div>
<div class="col-md-3 mb-2"><input class="form-control" name="amount" placeholder="Nominal" required/></div>
<div class="col-md-1 mb-2"><button class="btn btn-primary w-100" type="submit">OK</button></div>
</div></form></div>
<div class="card"><div class="table-responsive"><table class="table card-table"><thead><tr><th>ID</th><th>Nama</th><th>Nominal</th><th>Aktif</th></tr></thead>
<tbody>{{range .Data.Tariffs}}<tr><td>{{.ID}}</td><td>{{.Name}}</td><td>{{.Amount}}</td><td>{{.Active}}</td></tr>
{{else}}<tr><td colspan="4" class="text-center text-secondary py-4">Belum ada tarif. Tambahkan di atas.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "search"}}{{template "head" .}}{{template "page_open" .}}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Hasil pencarian: {{.Data.Q}}</h3></div>
<form method="get" action="/search"><div class="card-body d-flex gap-2"><input class="form-control" name="q" placeholder="Klien / permohonan / akta…" value="{{.Data.Q}}"/><button class="btn btn-primary" type="submit">Cari</button></div></form></div>
<div class="card"><div class="list-group list-group-flush">{{range .Data.Hits}}<a class="list-group-item" href="{{.URL}}"><span class="badge bg-azure-lt me-2">{{.Kind}}</span>{{.Title}}</a>{{else}}<div class="list-group-item text-secondary">Tidak ada hasil. Coba kata kunci lain.</div>{{end}}</div></div>
{{template "page_close" .}}{{end}}
