{{define "client_rows"}}{{range .}}<tr><td><a href="/clients/{{.ID}}">{{.FullName}}</a></td><td>{{.Kind}}</td><td>{{.Phone}}</td><td>{{.Email}}</td></tr>{{else}}<tr><td colspan="4" class="text-center text-secondary py-4">Tidak ada klien. <a class="btn btn-sm btn-primary ms-2" href="/clients/new">Tambah klien pertama →</a></td></tr>{{end}}{{end}}

{{define "clients"}}{{template "head" .}}{{template "page_open" .}}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/app">Dashboard</a></li><li class="breadcrumb-item active">Daftar Klien</li></ol></nav>
<div class="card mb-3"><div class="row g-0 align-items-center"><div class="col"><div class="card-body"><h3 class="card-title mb-1">Manajemen Klien</h3><p class="text-secondary mb-0">Perorangan & badan hukum, identitas terverifikasi manusia, beneficial owner.</p></div></div><div class="col-auto d-none d-md-block"><img src="/assets/landing/notarius-feat-klien.jpg" alt="Verifikasi klien" style="object-fit:cover;height:110px;width:220px;border-radius:0 8px 8px 0"/></div></div></div>
<div class="row g-2 mb-3">
<div class="col-sm-6 col-lg-2"><div class="card"><div class="card-body"><div class="subheader">Total</div><div class="h1 mb-0">{{.Data.Stats.Total}}</div></div></div></div>
<div class="col-sm-6 col-lg-2"><div class="card"><div class="card-body"><div class="subheader">Perorangan / Badan</div><div class="h1 mb-0">{{.Data.Stats.Individual}}<span class="text-secondary fs-5"> / {{.Data.Stats.Corporate}}</span></div></div></div></div>
<div class="col-sm-6 col-lg-2"><div class="card"><div class="card-body"><div class="subheader">Dalam proses</div><div class="h1 mb-0">{{.Data.Stats.InProcess}}</div></div></div></div>
<div class="col-sm-6 col-lg-2"><div class="card"><div class="card-body"><div class="subheader">Dokumen kurang</div><div class="h1 mb-0">{{.Data.Stats.DocsIncomplete}}</div></div></div></div>
<div class="col-sm-6 col-lg-2"><div class="card"><div class="card-body"><div class="subheader">Perlu verifikasi</div><div class="h1 mb-0">{{.Data.Stats.PendingVerify}}</div></div></div></div>
<div class="col-sm-6 col-lg-2"><div class="card"><div class="card-body"><div class="subheader">Tagihan belum lunas</div><div class="h1 mb-0">{{.Data.Stats.Unpaid}}</div></div></div></div>
</div>
<form method="post" action="/clients/bulk" id="bulkform">{{template "csrf" .}}
<div class="card"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2"><h3 class="card-title">Daftar Klien ({{.Data.Total}})</h3>
<div class="d-flex gap-2"><a class="btn btn-outline-primary" href="/clients/export?q={{.Data.Q}}&kind={{.Data.Kind}}&status={{.Data.Status}}&service={{.Data.Service}}&province={{.Data.Province}}&city={{.Data.City}}&from={{.Data.From}}&to={{.Data.To}}&docs={{.Data.Docs}}&sort={{.Data.Sort}}">Ekspor CSV</a><a class="btn btn-primary" href="/clients/new">+ Tambah Klien</a></div></div>
<div class="card-body border-bottom"><div class="row g-2">
<div class="col-md-3"><input class="form-control" type="search" name="q" placeholder="Cari nama / NIK4 / NPWP / telepon / email…" value="{{.Data.Q}}" form="filterform"/></div>
<div class="col-md-2"><select class="form-select" name="kind" form="filterform"><option value="">Semua jenis</option><option value="individual" {{if eq .Data.Kind "individual"}}selected{{end}}>Perorangan</option><option value="corporate" {{if eq .Data.Kind "corporate"}}selected{{end}}>Badan usaha</option></select></div>
<div class="col-md-2"><select class="form-select" name="status" form="filterform"><option value="">Semua status</option><option value="ACTIVE" {{if eq .Data.Status "ACTIVE"}}selected{{end}}>Aktif</option><option value="INACTIVE" {{if eq .Data.Status "INACTIVE"}}selected{{end}}>Nonaktif</option><option value="ARCHIVED" {{if eq .Data.Status "ARCHIVED"}}selected{{end}}>Arsip</option></select></div>
<div class="col-md-2"><select class="form-select" name="docs" form="filterform"><option value="">Dokumen: semua</option><option value="missing" {{if eq .Data.Docs "missing"}}selected{{end}}>Belum ada berkas</option><option value="complete" {{if eq .Data.Docs "complete"}}selected{{end}}>Ada berkas</option></select></div>
<div class="col-md-2"><select class="form-select" name="sort" form="filterform"><option value="">Terbaru</option><option value="name_asc" {{if eq .Data.Sort "name_asc"}}selected{{end}}>Nama A–Z</option><option value="name_desc" {{if eq .Data.Sort "name_desc"}}selected{{end}}>Nama Z–A</option><option value="oldest" {{if eq .Data.Sort "oldest"}}selected{{end}}>Terlama</option></select></div>
<div class="col-md-2"><select class="form-select" name="service" form="filterform"><option value="">Semua layanan</option>{{range .Data.Services}}<option value="{{.Code}}">{{.Name}}</option>{{end}}</select></div>
<div class="col-md-2"><select class="form-select" name="province" form="filterform"><option value="">Semua provinsi</option>{{range .Data.Provinces}}<option {{if eq $.Data.Province .}}selected{{end}}>{{.}}</option>{{end}}</select></div>
<div class="col-md-2"><input class="form-control" name="city" placeholder="Kota" value="{{.Data.City}}" form="filterform"/></div>
<div class="col-md-2"><input class="form-control" type="date" name="from" value="{{.Data.From}}" form="filterform"/></div>
<div class="col-md-2"><input class="form-control" type="date" name="to" value="{{.Data.To}}" form="filterform"/></div>
<div class="col-md-1"><select class="form-select" name="per_page" form="filterform">{{if eq .Data.PerPage 10}}<option selected>10</option>{{else}}<option>10</option>{{end}}{{if eq .Data.PerPage 20}}<option selected>20</option>{{else}}<option>20</option>{{end}}{{if eq .Data.PerPage 50}}<option selected>50</option>{{else}}<option>50</option>{{end}}{{if eq .Data.PerPage 100}}<option selected>100</option>{{else}}<option>100</option>{{end}}</select></div>
<div class="col-md-1 d-grid"><button class="btn btn-primary" type="submit" form="filterform">Filter</button></div>
</div></div>
<form method="get" action="/clients" id="filterform" class="d-none"></form>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th><input type="checkbox" id="checkall" aria-label="Pilih semua"/></th><th>Nama</th><th>Jenis</th><th>Telepon</th><th>Email</th><th>Dibuat</th></tr></thead>
<tbody>{{range .Data.List}}<tr><td><input type="checkbox" name="ids" value="{{.ID}}" form="bulkform" aria-label="Pilih {{.FullName}}"/></td><td><a href="/clients/{{.ID}}">{{.FullName}}</a></td><td><span class="badge bg-azure-lt">{{.Kind}}</span></td><td>{{.Phone}}</td><td>{{.Email}}</td><td class="text-secondary">{{.CreatedAt}}</td></tr>
{{else}}<tr><td colspan="6" class="text-center text-secondary py-4">Tidak ada klien. <a class="btn btn-sm btn-primary ms-2" href="/clients/new">Tambah klien pertama →</a></td></tr>{{end}}</tbody></table></div>
{{if gt .Data.Pages 1}}<div class="card-footer d-flex gap-2 align-items-center flex-wrap"><span class="text-secondary">Halaman {{.Data.Page}} dari {{.Data.Pages}} · {{.Data.Total}} klien</span><ul class="pagination mb-0 ms-auto"><li class="page-item {{if eq .Data.Page 1}}disabled{{end}}"><a class="page-link" href="/clients?{{.Data.QS}}&page={{.Data.Prev}}">«</a></li><li class="page-item active"><a class="page-link" href="#">{{.Data.Page}}</a></li><li class="page-item {{if eq .Data.Page .Data.Pages}}disabled{{end}}"><a class="page-link" href="/clients?{{.Data.QS}}&page={{.Data.Next}}">»</a></li></ul></div>{{end}}
<div class="card-footer d-flex gap-2 align-items-center border-top"><span class="text-secondary small">Aksi massal (yang dicentang):</span><select class="form-select" style="max-width:200px" name="to"><option value="INACTIVE">Nonaktifkan</option><option value="ACTIVE">Aktifkan</option><option value="ARCHIVED">Arsipkan</option></select><button class="btn btn-outline-danger" type="submit" onclick="return confirm('Ubah status klien yang dipilih?')">Terapkan</button></div>
</div></form>
<script>(function(){var c=document.getElementById('checkall');if(!c)return;c.addEventListener('change',function(){document.querySelectorAll('#bulkform input[name="ids"]').forEach(function(x){x.checked=c.checked;});});})();
{{template "page_close" .}}{{end}}
