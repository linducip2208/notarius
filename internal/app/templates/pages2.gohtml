{{define "mfa"}}{{template "head" .}}{{template "page_open" .}}
<div class="card"><div class="card-header"><h3 class="card-title">Autentikasi Dua Faktor (TOTP)</h3></div>
<div class="card-body">
{{if .Data}}{{if .Data.Error}}<div class="alert alert-danger">{{.Data.Error}}</div>{{end}}{{end}}
{{if .Data.Enabled}}<div class="alert alert-success">MFA sudah aktif untuk akun Anda.</div>{{end}}
{{if and (not .Data.Enabled) (or (eq .Role "notary") (eq .Role "super_admin") (eq .Role "substitute_notary") (eq .Role "auditor"))}}<div class="alert alert-warning" role="alert">Akun Anda berhak akses wasiat — aktifkan MFA untuk melindungi register wasiat.</div>{{end}}
<p class="text-secondary">Pindai ke aplikasi autentikator (Google/Microsoft Authenticator), lalu masukkan 6 digit kode.</p>
{{if .Data.Secret}}<p>Secret (bila QR tak terbaca): <code>{{.Data.Secret}}</code></p>
<p class="text-secondary small">otpauth URI: <code>{{.Data.URI}}</code></p>{{end}}
<form method="post" action="/mfa">{{template "csrf" .}}
<input type="hidden" name="secret" value="{{.Data.Secret}}"/>
<div class="mb-3"><label class="form-label">Kata sandi saat ini (wajib untuk enroll)</label><input class="form-control" type="password" name="password" required/></div>
<div class="mb-3"><label class="form-label">Kode 6 digit</label><input class="form-control" name="code" maxlength="6" required/></div>
<button class="btn btn-primary" type="submit">Aktifkan MFA</button></form>
</div></div>
{{template "page_close" .}}{{end}}

{{define "mfa_verify"}}{{template "head" .}}
<body class="d-flex flex-column"><div class="page page-center"><div class="container container-tight py-4">
<form class="card card-md" method="post" action="/mfa/verify"><div class="card-body">{{template "csrf" .}}
<h2 class="card-title text-center mb-4">Verifikasi MFA</h2>
{{if .Data}}{{if .Data.Error}}<div class="alert alert-danger">{{.Data.Error}}</div>{{end}}{{end}}
<div class="mb-3"><label class="form-label">Kode autentikator</label><input class="form-control" name="code" maxlength="6" required/></div>
<button class="btn btn-primary w-100" type="submit">Verifikasi</button>
</div></form></div></div></body></html>{{end}}

{{define "request_detail"}}{{template "head" .}}{{template "page_open" .}}
<div class="row"><div class="col-md-7">
<div class="card"><div class="card-header"><h3 class="card-title">#{{.Data.Req.ID}} — {{.Data.Req.Title}}</h3></div>
<div class="card-body"><dl class="row">
<dt class="col-4">Klien</dt><dd class="col-8"><a href="/clients/{{.Data.Req.ClientID}}">{{.Data.Req.ClientName}}</a></dd>
<dt class="col-4">Layanan</dt><dd class="col-8">{{.Data.Req.Service}}</dd>
<dt class="col-4">Status</dt><dd class="col-8"><span class="badge bg-blue-lt">{{.Data.Req.Status}}</span></dd>
<dt class="col-4">Catatan</dt><dd class="col-8">{{.Data.Req.Notes}}</dd>
</dl>
<form method="post" action="/requests/{{.Data.Req.ID}}/move" class="d-flex gap-1 flex-wrap">{{template "csrf" .}}
<select class="form-select" name="to"><option value="SUBMITTED">SUBMITTED</option><option value="IN_REVIEW">IN_REVIEW</option><option value="NEED_DOCS">NEED_DOCS</option><option value="APPROVED">APPROVED</option><option value="IN_PROGRESS">IN_PROGRESS</option><option value="COMPLETED">COMPLETED</option><option value="REJECTED">REJECTED</option><option value="CANCELLED">CANCELLED</option></select>
<input class="form-control" name="note" placeholder="Catatan perubahan"/>
<button class="btn btn-primary" type="submit">Ubah Status</button></form>
<div class="card-body border-top"><a class="btn btn-sm btn-outline-primary" href="/finance?req={{.Data.Req.ID}}">+ Buat Invoice Permohonan Ini</a>{{if .Data.WALink}} <a class="btn btn-sm btn-success" href="{{.Data.WALink}}" target="_blank" rel="noopener" title="Buka chat WhatsApp ke {{.Data.WAPhone}} (manual, tanpa gateway)">Kirim pengingat WA ke klien</a>{{else}} <span class="text-secondary small" title="Isi nomor telepon/WA klien di /clients agar tombol WA muncul">WA klien: nomor belum tersedia</span>{{end}}{{if and (ne .Data.Req.Status "COMPLETED") (ne .Data.Req.Status "REJECTED") (ne .Data.Req.Status "CANCELLED")}} <form method="post" action="/deeds" class="d-inline">{{template "csrf" .}}<input type="hidden" name="request_id" value="{{.Data.Req.ID}}"/><input type="hidden" name="title" value="{{.Data.Req.Service}} — {{.Data.Req.Title}}"/><button class="btn btn-sm btn-outline-success" type="submit">📄 Buat Draf Akta</button></form>{{end}}</div></div>
{{if .Data.CorpWarn}}<div class="alert alert-warning mt-3"><strong>Konsistensi korporat perlu perhatian:</strong><ul class="mb-0">{{range .Data.CorpWarn}}<li>{{.}}</li>{{end}}</ul></div>{{end}}
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Data Korporat</h3><div class="ms-auto d-flex gap-1"><a class="btn btn-sm btn-outline-primary" href="/requests/{{.Data.Req.ID}}/wizard">Wizard Korporat →</a>{{if or (eq .Data.SvcCode "PPAT-AJB") (eq .Data.SvcCode "PPAT-HIBAH") (eq .Data.SvcCode "PPAT-TUKAR") (eq .Data.SvcCode "PPAT-APHB") (eq .Data.SvcCode "PPAT-INBRENG") (eq .Data.SvcCode "PPAT-SKMHT") (eq .Data.SvcCode "PPAT-APHT") (eq .Data.SvcCode "BUNDEL-AJB-BALIKNAMA")}}<a class="btn btn-sm btn-outline-success" href="/requests/{{.Data.Req.ID}}/wizard-ajb">Wizard AJB →</a>{{end}}{{if or (eq .Data.SvcCode "WASIAT") (eq .Data.SvcCode "WASIAT-DAFTAR")}}<a class="btn btn-sm btn-outline-warning" href="/requests/{{.Data.Req.ID}}/wizard-wasiat">Wizard Wasiat →</a>{{end}}</div></div>
<form method="post" action="/requests/{{.Data.Req.ID}}/corp"><div class="card-body row">{{template "csrf" .}}
<div class="col-md-4 mb-2"><select class="form-select" name="entity_type"><option value="PT">PT</option><option value="CV">CV</option><option value="Firma">Firma</option><option value="Yayasan">Yayasan</option><option value="Koperasi">Koperasi</option><option value="Perkumpulan">Perkumpulan</option></select></div>
<div class="col-md-8 mb-2"><input class="form-control" name="name" placeholder="Nama badan usaha" value="{{.Data.Company.Name}}" required/></div>
<div class="col-md-6 mb-2"><input class="form-control" name="domicile" placeholder="Kedudukan" value="{{.Data.Company.Domicile}}"/></div>
<div class="col-md-6 mb-2"><input class="form-control" name="address" placeholder="Alamat" value="{{.Data.Company.Address}}"/></div>
<div class="col-md-4 mb-2"><input class="form-control" name="authorized" placeholder="Modal dasar" value="{{.Data.Company.Authorized}}"/></div>
<div class="col-md-4 mb-2"><input class="form-control" name="issued" placeholder="Modal ditempatkan" value="{{.Data.Company.Issued}}"/></div>
<div class="col-md-4 mb-2"><input class="form-control" name="paid" placeholder="Modal disetor" value="{{.Data.Company.Paid}}"/></div>
<div class="col-12 text-end"><button class="btn btn-primary" type="submit">Simpan Korporat</button></div>
</div></form>
<form method="post" action="/requests/{{.Data.Req.ID}}/corp/legal"><div class="card-body row border-top">{{template "csrf" .}}
<div class="col-12 mb-1"><strong>Legalitas terverifikasi manual</strong> <span class="text-secondary small">(salin dari dokumen fisik/SK — bukan integrasi AHU/OSS)</span></div>
<div class="col-md-4 mb-2"><input class="form-control" name="deed_no" placeholder="No. akta pendirian" value="{{.Data.Legal.DeedNo}}"/></div>
<div class="col-md-4 mb-2"><input class="form-control" type="date" name="deed_date" value="{{.Data.Legal.DeedDate}}"/></div>
<div class="col-md-4 mb-2"><input class="form-control" name="ahu_no" placeholder="No. SK AHU" value="{{.Data.Legal.AHUNo}}"/></div>
<div class="col-md-4 mb-2"><input class="form-control" name="amendment_no" placeholder="No. akta perubahan" value="{{.Data.Legal.AmendmentNo}}"/></div>
<div class="col-md-4 mb-2"><input class="form-control" type="date" name="amendment_date" value="{{.Data.Legal.AmendmentDate}}"/></div>
<div class="col-md-4 mb-2"><input class="form-control" name="nib" placeholder="NIB" value="{{.Data.Legal.NIB}}"/></div>
<div class="col-md-6 mb-2"><input class="form-control" name="npwp" placeholder="NPWP badan" value="{{.Data.Legal.NPWP}}"/></div>
<div class="col-md-6 mb-2 text-end"><button class="btn btn-outline-primary" type="submit">Simpan Legalitas</button></div>
</div></form></div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Para Pihak</h3></div>
<div class="table-responsive"><table class="table card-table table-sm"><thead><tr><th>Nama</th><th>Peran</th>{{if can .Role "client.edit"}}<th></th>{{end}}</tr></thead>
<tbody>{{range .Data.Parties}}<tr><td><a href="/clients/{{.ClientID}}">{{.ClientName}}</a></td><td><span class="badge bg-azure-lt">{{.Role}}</span></td>{{if can $.Role "client.edit"}}<td><form method="post" action="/requests/{{$.Data.Req.ID}}/parties/{{.ID}}/delete" class="d-inline">{{template "csrf" $}}<button class="btn btn-sm btn-ghost-danger" type="submit" onclick="return confirm('Hapus pihak ini?')">Hapus</button></form></td>{{end}}</tr>{{else}}<tr><td colspan="3" class="text-secondary">Belum ada pihak tambahan — klien utama <a href="/clients/{{.Data.Req.ClientID}}">{{.Data.Req.ClientName}}</a> dianggap <span class="badge bg-azure-lt">PENGHADAP</span> secara implisit.</td></tr>{{end}}</tbody></table></div>
{{if can .Role "client.edit"}}<form method="post" action="/requests/{{.Data.Req.ID}}/parties"><div class="card-body d-flex gap-1 flex-wrap">{{template "csrf" .}}<select class="form-select" name="client_id" required style="max-width:220px"><option value="">— Klien existing —</option>{{range .Data.PartyClients}}<option value="{{.ID}}">{{.FullName}}</option>{{end}}</select><select class="form-select" name="role" required style="max-width:190px">{{range .Data.PartyRoles}}<option value="{{.}}">{{.}}</option>{{end}}</select><button class="btn btn-sm btn-primary" type="submit">Tambah Pihak</button></div></form>{{end}}</div>
{{if .Data.Ppat}}<div class="card mt-3"><div class="card-header"><h3 class="card-title">Register PPAT Terkait</h3><div class="ms-auto"><a class="btn btn-sm btn-outline-success" href="/ppat">+ Catat di PPAT</a></div></div>
<div class="table-responsive"><table class="table card-table table-sm"><thead><tr><th>No. Akta</th><th>Jenis</th><th>Status</th></tr></thead>
<tbody>{{range .Data.Ppat}}<tr><td><a href="/ppat">{{.No}}</a></td><td>{{.Jenis}}</td><td><span class="badge bg-blue-lt">{{.Status}}</span></td></tr>{{end}}</tbody></table></div>
<div class="card-body border-top"><a class="btn btn-sm btn-ghost-primary" href="/ppat">Buka Register PPAT →</a></div></div>{{end}}
<div class="row"><div class="col-md-6"><div class="card mt-3"><div class="card-header"><h3 class="card-title">Pemegang Saham</h3></div>
<div class="card-body">{{range .Data.Shareholders}}<div class="mb-2">{{.Name}} — {{.Shares}} lbr @ {{.Nominal}}
<form method="post" action="/requests/{{$.Data.Req.ID}}/shareholders/{{.ID}}/link" class="d-flex gap-1 mt-1">{{template "csrf" $}}<input class="form-control form-control-sm" name="client_id" placeholder="ID klien tertaut" style="max-width:130px"/><button class="btn btn-sm btn-ghost-primary" type="submit" title="Tautkan ke data klien">Tautkan</button></form></div>{{else}}<p class="text-secondary">Belum ada.</p>{{end}}
<form method="post" action="/requests/{{.Data.Req.ID}}/shareholders">{{template "csrf" .}}
<div class="mb-2"><input class="form-control" name="name" placeholder="Nama" required/></div>
<div class="row"><div class="col-6 mb-2"><input class="form-control" name="shares" placeholder="Lembar" value="1"/></div>
<div class="col-6 mb-2"><input class="form-control" name="nominal" placeholder="Nominal/lbr" value="0"/></div></div>
<button class="btn btn-sm btn-primary w-100" type="submit">Tambah</button></form></div></div></div>
<div class="col-md-6"><div class="card mt-3"><div class="card-header"><h3 class="card-title">Pengurus</h3></div>
<div class="card-body">{{range .Data.Officers}}<div class="mb-1"><span class="badge bg-azure-lt">{{.Role}}</span> {{.Name}} {{.Title}}</div>{{else}}<p class="text-secondary">Belum ada.</p>{{end}}
<form method="post" action="/requests/{{.Data.Req.ID}}/officers">{{template "csrf" .}}
<div class="mb-2"><select class="form-select" name="role"><option value="DIREKTUR">DIREKTUR</option><option value="KOMISARIS">KOMISARIS</option><option value="PENGURUS">PENGURUS</option><option value="PENGAWAS">PENGAWAS</option><option value="SEKUTU">SEKUTU</option></select></div>
<div class="mb-2"><input class="form-control" name="name" placeholder="Nama" required/></div>
<div class="mb-2"><input class="form-control" name="title" placeholder="Jabatan (Dir. Utama, dsb)"/></div>
<button class="btn btn-sm btn-primary w-100" type="submit">Tambah</button></form></div></div></div>
</div>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Beneficial Owner (pemilik manfaat)</h3></div>
<div class="card-body">{{range .Data.BOs}}<div class="mb-1">{{.Name}} — {{.OwnershipPct}}% {{if .IsPEP}}<span class="badge bg-red-lt">PEP</span>{{end}} <span class="text-secondary">•••• {{.NIKLast4}}</span></div>{{else}}<p class="text-secondary">Belum ada BO. Wajib untuk PT/CV (TPPU).</p>{{end}}
<p class="text-secondary small mb-0">PEP = politically exposed person: wajib uji tuntas lanjutan (enhanced due diligence) sesuai ketentuan TPPU. Catat hasilnya sebagai catatan klien.</p>
<form method="post" action="/requests/{{.Data.Req.ID}}/bo">{{template "csrf" .}}
<div class="row"><div class="col-12 col-md-5 mb-2"><input class="form-control" name="name" placeholder="Nama pemilik manfaat" required/></div>
<div class="col-6 col-md-3 mb-2"><input class="form-control" name="nik" placeholder="NIK (terenkripsi parsial)"/></div>
<div class="col-6 col-md-2 mb-2"><input class="form-control" name="pct" placeholder="%" value="25"/></div>
<div class="col-12 col-md-2 mb-2"><label class="form-check"><input class="form-check-input" type="checkbox" name="pep" value="1"/> PEP</label></div></div>
<button class="btn btn-sm btn-primary w-100" type="submit">Catat BO</button></form></div></div>
{{if .Data.Company.ID}}<div class="card mt-3"><div class="card-header"><h3 class="card-title">Struktur Kepemilikan (cetak)</h3><div class="ms-auto"><button class="btn btn-sm btn-ghost-primary" type="button" onclick="window.print()">Cetak</button></div></div>
<div class="card-body"><strong>{{.Data.Company.Name}}</strong> ({{.Data.Company.EntityType}})
<p class="mb-1 mt-2"><strong>Pemegang saham:</strong></p>
<ul>{{range .Data.Shareholders}}<li>{{.Name}} — {{.Shares}} lembar</li>{{else}}<li class="text-secondary">Belum ada pemegang saham.</li>{{end}}</ul>
<p class="mb-1"><strong>Pengurus:</strong></p>
<ul>{{range .Data.Officers}}<li><span class="badge bg-azure-lt">{{.Role}}</span> {{.Name}}{{if .Title}} ({{.Title}}){{end}}</li>{{else}}<li class="text-secondary">Belum ada pengurus.</li>{{end}}</ul></div></div>{{end}}
</div>
<div class="col-md-5">
<div class="card"><div class="card-header"><h3 class="card-title">Linimasa</h3></div>
<div class="card-body">{{range .Data.Req.Events}}<div class="mb-2"><span class="badge bg-blue-lt">{{.From}} → {{.To}}</span> <span class="text-secondary">{{.Actor}} · {{.At}}</span><div>{{.Note}}</div></div>{{else}}<p class="text-secondary">Belum ada peristiwa.</p>{{end}}</div></div>
<div class="card mt-3" id="alurkerja"><div class="card-header"><h3 class="card-title">Alur Kerja{{if .Data.WFStatus}} <span class="badge bg-blue-lt">{{.Data.WFStatus}}</span>{{end}}</h3></div>
{{if .Data.WFHas}}<div class="list-group list-group-flush">{{range .Data.WF}}<div class="list-group-item d-flex justify-content-between align-items-center"><span>{{.Label}} <span class="text-secondary small">({{.Key}}{{if .RequiredRole}} · {{.RequiredRole}}{{end}})</span></span><span class="badge {{if eq .Status "DONE"}}bg-green-lt{{else if .Current}}bg-yellow-lt{{else}}bg-blue-lt{{end}}">{{if .Current}}BERJALAN{{else}}{{.Status}}{{end}}</span></div>{{end}}</div>
{{if and (can .Role "client.edit") (ne .Data.WFStatus "COMPLETED")}}<div class="card-body border-top"><form method="post" action="/requests/{{.Data.Req.ID}}/workflow/step" class="d-flex gap-1">{{template "csrf" .}}<input class="form-control form-control-sm" name="note" placeholder="Catatan langkah (opsional)"/><button class="btn btn-sm btn-primary" type="submit">Maju 1 langkah{{if .Data.WFCur}} ({{.Data.WFCur}}){{end}}</button></form><p class="text-secondary small mb-0 mt-1">Independen dari status permohonan — hanya memajukan alur kerja. Langkah berlabel notaris wajib dilakukan akun berizin approve akta.</p></div>{{end}}
{{else}}<div class="card-body text-secondary small">Belum ada template alur kerja untuk layanan ini. Pasang via DMS → Checklist → “Pasang paket standar”.</div>{{end}}</div>
<div class="card mt-3" id="checklist"><div class="card-header"><h3 class="card-title">Checklist Berkas ({{.Data.CheckDone}}/{{.Data.CheckTotal}})</h3></div>
{{if .Flash}}<div class="card-body border-bottom py-2"><div class="alert alert-warning py-1 px-2 mb-0 small">{{.Flash}}</div></div>{{end}}
{{if gt .Data.CheckTotal 0}}<div class="progress mx-3 mt-3" style="height:8px"><div class="progress-bar" style="width:{{.Data.CheckPct}}%"></div></div>{{end}}
<div class="list-group list-group-flush">{{range .Data.Checklist}}<div class="list-group-item"><span class="badge {{if eq .Status "VERIFIED"}}bg-green-lt{{else if eq .Status "MISSING"}}bg-red-lt{{else}}bg-yellow-lt{{end}} me-2">{{.Status}}</span>{{.Label}}<form method="post" action="/requests/{{$.Data.Req.ID}}/checklist" class="d-flex gap-1 mt-1">{{template "csrf" $}}<input type="hidden" name="item_id" value="{{.ID}}"/><select class="form-select form-select-sm" name="status"><option>MISSING</option><option>RECEIVED</option><option>VERIFIED</option><option>REJECTED</option><option>NEEDS_REVISION</option></select><button class="btn btn-sm btn-outline-primary" type="submit">OK</button></form></div>{{else}}<div class="list-group-item text-secondary">Belum ada template checklist untuk layanan ini. <a href="/dms/checklists">Buat template →</a></div>{{end}}</div></div>
{{if .Data.LinkedDocs}}<div class="card mt-3"><div class="card-header"><h3 class="card-title">Dokumen Terkait</h3></div>
<div class="list-group list-group-flush">{{range .Data.LinkedDocs}}<a class="list-group-item" href="/documents/{{.}}">Berkas #{{.}}</a>{{end}}</div></div>{{end}}
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Pengajuan AHU/OSS terkait</h3></div>
<div class="card-body">{{range .Data.Gov}}<div class="mb-1">{{.Channel}} — {{.Reference}} ({{.Status}})</div>{{else}}<p class="text-secondary">Belum ada. Buat dari halaman AHU &amp; OSS.</p>{{end}}</div></div>
</div></div>
{{template "page_close" .}}{{end}}

{{define "appointments"}}{{template "head" .}}{{template "page_open" .}}
<div class="card mb-3"><div class="card-header"><h3 class="card-title">Jadwalkan Kunjungan</h3></div>
<form method="post" action="/appointments"><div class="card-body row">{{template "csrf" .}}
<div class="col-md-4 mb-2"><select class="form-select" name="client_id" required><option value="">— Klien —</option>{{range .Data.Clients}}<option value="{{.ID}}">{{.FullName}}</option>{{end}}</select></div>
<div class="col-md-4 mb-2"><input class="form-control" type="datetime-local" name="scheduled_at" required/></div>
<div class="col-md-3 mb-2"><input class="form-control" name="purpose" placeholder="Keperluan" required/></div>
<div class="col-md-1 mb-2"><button class="btn btn-primary w-100" type="submit">OK</button></div>
</div></form></div>
{{if .Data.Week}}<div class="card mb-3"><div class="card-header"><h3 class="card-title">Kalender 14 Hari</h3></div>
<div class="table-responsive"><table class="table card-table"><thead><tr><th>Tanggal</th><th>Agenda</th></tr></thead>
<tbody>{{range .Data.Week}}<tr><td style="white-space:nowrap"><strong>{{.Day}}</strong></td><td>{{range .Items}}<span class="badge bg-azure-lt me-1">{{.Time}} · {{.Client}} — {{.Purpose}} ({{.Status}})</span>{{end}}</td></tr>{{end}}</tbody></table></div></div>{{end}}
<div class="card"><div class="card-header"><h3 class="card-title">Janji Temu</h3></div>
<div class="table-responsive"><table class="table card-table table-vcenter"><thead><tr><th>Jadwal</th><th>Klien</th><th>Keperluan</th><th>Status</th><th>Ubah</th></tr></thead>
<tbody>{{range .Data.List}}<tr><td>{{.At}}</td><td>{{.ClientID}}</td><td>{{.Purpose}}</td><td>{{.Status}}</td><td><form method="post" action="/appointments/{{.ID}}/status" class="d-flex gap-1">{{template "csrf" $}}<select class="form-select form-select-sm" name="to"><option value="DONE">DONE</option><option value="CANCELLED">CANCELLED</option><option value="NOSHOW">NOSHOW</option></select><button class="btn btn-sm btn-outline-primary" type="submit">OK</button></form></td></tr>
{{else}}<tr><td colspan="5" class="text-center text-secondary py-4">Belum ada janji.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "template_edit"}}{{template "head" .}}{{template "page_open" .}}
<div class="card"><div class="card-header"><h3 class="card-title">{{.Data.T.Name}} (v{{.Data.T.Version}} · approved={{.Data.T.Approved}})</h3></div>
<div class="card-body">
<div class="alert alert-info">Variabel tersedia: {{range .Data.Vars}}<code>{{.}}</code> {{end}}</div>
{{if .Data.Missing}}<div class="alert alert-warning">Variabel contoh belum diisi: {{range .Data.Missing}}<code>{{.}}</code> {{end}}</div>{{end}}
<h4>Pratinjau (DRAFT)</h4>
<pre class="p-3 bg-light border rounded">{{.Data.Preview}}</pre>
<form method="post" action="/templates/{{.Data.T.ID}}/approve">{{template "csrf" .}}<button class="btn btn-success" type="submit">Setujui sebagai Notaris</button></form>
</div></div>
{{template "page_close" .}}{{end}}
