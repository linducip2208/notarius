{{define "receipt"}}{{template "head" .}}{{template "page_open" .}}
<nav aria-label="breadcrumb" class="no-print"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/finance">Keuangan</a></li><li class="breadcrumb-item active">Kuitansi {{.Data.Number}}</li></ol></nav>
<div class="card" style="max-width:640px"><div class="card-body p-4">
<div class="d-flex justify-content-between align-items-center mb-3">
<div><h2 class="mb-0">KUITANSI PEMBAYARAN</h2><div class="text-secondary">{{.Brand.AppName}} · {{.Data.Number}} {{if eq .Data.Kind "DP"}}<span class="badge bg-yellow-lt ms-1">DP — uang muka</span>{{else if eq .Data.Kind "PELUNASAN"}}<span class="badge bg-purple-lt ms-1">PELUNASAN</span>{{else if hasPrefix .Data.Number "[DP]"}}<span class="badge bg-yellow-lt ms-1">DP — uang muka</span>{{else if hasPrefix .Data.Number "[PELUNASAN]"}}<span class="badge bg-purple-lt ms-1">PELUNASAN</span>{{end}}</div></div>
<img src="/qr/inv/{{.Data.ID}}" alt="QR verifikasi" style="width:110px;height:110px"/>
</div>
{{if eq .Data.Kind "DP"}}<div class="alert alert-info py-2 small">Invoice uang muka (DP) — sisa tagihan ditagih lewat invoice PELUNASAN terpisah.</div>{{end}}
<dl class="row"><dt class="col-4">Klien</dt><dd class="col-8">{{.Data.Client}}</dd>
<dt class="col-4">Total</dt><dd class="col-8">Rp {{.Data.Total}}</dd>
<dt class="col-4">Dibayar</dt><dd class="col-8">Rp {{.Data.Paid}}</dd>
<dt class="col-4">Sisa</dt><dd class="col-8">Rp {{if .Data.Outstanding}}{{.Data.Outstanding}}{{else}}{{sub .Data.Total .Data.Paid}}{{end}}</dd>
<dt class="col-4">Status</dt><dd class="col-8"><span class="badge bg-green-lt">{{.Data.Status}}</span></dd>
<dt class="col-4">Kode verifikasi</dt><dd class="col-8"><code>{{.Data.Code}}</code></dd></dl>
<div class="card mt-3"><div class="card-header"><h3 class="card-title">Riwayat Pembayaran</h3></div>
{{if .Data.Payments}}<div class="table-responsive"><table class="table table-sm card-table mb-0"><thead><tr><th>Waktu</th><th>Metode</th><th>Referensi</th><th class="text-end">Nominal</th></tr></thead>
<tbody>{{range .Data.Payments}}<tr><td class="text-secondary small">{{.PaidAt}}</td><td><span class="badge bg-blue-lt">{{.Method}}</span></td><td class="small">{{if .Reference}}{{.Reference}}{{else}}<span class="text-secondary">—</span>{{end}}</td><td class="text-end">Rp {{.Amount}}</td></tr>{{end}}</tbody></table></div>
{{else}}<div class="card-body"><p class="text-secondary small mb-0">Total Rp {{.Data.Total}} · Dibayar Rp {{.Data.Paid}} · Sisa Rp {{if .Data.Outstanding}}{{.Data.Outstanding}}{{else}}{{sub .Data.Total .Data.Paid}}{{end}} · Status <span class="badge bg-green-lt">{{.Data.Status}}</span>. Rincian per pembayaran tercatat setelah pembayaran pertama dicatat.</p></div>{{end}}</div>
<p class="text-secondary small mt-3">Pindai QR / cocokkan kode di halaman <a href="/verify?code={{.Data.Code}}">verifikasi publik</a>. Dokumen ini sah bila status LUNAS dan kode cocok.</p>
<div class="d-flex gap-2 no-print"><button class="btn btn-primary" type="button" onclick="window.print()">Cetak</button><a class="btn btn-outline-primary" href="/finance">Kembali</a></div>
</div></div>
{{template "page_close" .}}{{end}}

{{define "handover_receipt"}}{{template "head" .}}{{template "page_open" .}}
<nav aria-label="breadcrumb" class="no-print"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/deeds/{{.Data.DeedID}}">Akta #{{.Data.DeedID}}</a></li><li class="breadcrumb-item active">Tanda Terima Serah</li></ol></nav>
<div class="card" style="max-width:680px"><div class="card-body p-4">
<div class="text-center mb-3">
<div><strong>{{.Data.Office}}</strong>{{if .Data.Notary}} · Notaris {{.Data.Notary}}{{end}}</div>
{{if .Data.Address}}<div class="text-secondary small">{{.Data.Address}}</div>{{end}}
{{if or .Data.Phone .Data.Email}}<div class="text-secondary small">{{.Data.Phone}}{{if and .Data.Phone .Data.Email}} · {{end}}{{.Data.Email}}</div>{{end}}
</div>
<h2 class="text-center mb-1">TANDA TERIMA SERAH DOKUMEN</h2>
<p class="text-center text-secondary small">Akta {{if .Data.Number}}{{.Data.Number}} — {{end}}{{.Data.Title}}</p>
<dl class="row mt-3"><dt class="col-4">Diserahkan kepada</dt><dd class="col-8"><strong>{{.Data.To}}</strong></dd>
<dt class="col-4">Tanggal serah</dt><dd class="col-8">{{.Data.At}}</dd>
<dt class="col-4">Dicatat oleh</dt><dd class="col-8">{{if .Data.By}}{{.Data.By}}{{else}}<span class="text-secondary">—</span>{{end}}</dd>
{{if .Data.Note}}<dt class="col-4">Catatan</dt><dd class="col-8">{{.Data.Note}}</dd>{{end}}
<dt class="col-4">Kode verifikasi</dt><dd class="col-8"><code>{{.Data.Code}}</code></dd></dl>
<p class="text-secondary small">Kode di atas adalah referensi integritas internal (16 karakter pertama SHA-256 atas kantor|akta|serah|nomor|penerima|waktu|catatan). <strong>Tanpa QR</strong> — infrastruktur QR hanya untuk kuitansi invoice (<code>/qr/inv</code>) dan halaman <code>/verify</code> hanya mengenal kode INV/DEED, sehingga kode serah ini <strong>belum dapat dicek via <code>/verify</code></strong>. Keaslian dicocokkan manual dengan riwayat serah di halaman detail akta.</p>
<div class="row mt-4"><div class="col-6 text-center"><br/><br/><br/>_________________________<br/><span class="text-secondary small">Yang menyerahkan (kantor)</span></div>
<div class="col-6 text-center"><br/><br/><br/>_________________________<br/><span class="text-secondary small">Penerima ({{.Data.To}})</span></div></div>
<div class="d-flex gap-2 mt-4 no-print"><button class="btn btn-primary" type="button" onclick="window.print()">Cetak</button><a class="btn btn-outline-primary" href="/deeds/{{.Data.DeedID}}">Kembali ke akta</a></div>
</div></div>
{{template "page_close" .}}{{end}}

{{define "verify"}}{{template "head" .}}
<body class="d-flex flex-column"><div class="page page-center"><div class="container container-tight py-4">
<div class="text-center mb-4"><h1>{{.Brand.AppName}}</h1><p class="text-secondary">Verifikasi keaslian kuitansi — tanpa login</p></div>
<div class="card card-md"><div class="card-body">
<form method="get" action="/verify"><div class="mb-3"><label class="form-label">Kode verifikasi (cth. INV-12-AB34CD56)</label><input class="form-control" name="code" value="{{.Data.Code}}" required/></div>
<button class="btn btn-primary w-100" type="submit">Periksa</button></form>
{{if .Data.Error}}<div class="alert alert-danger mt-3">{{.Data.Error}}</div>{{end}}
{{if .Data.Found}}<div class="alert alert-success mt-3"><strong>TERVERIFIKASI ✓</strong><br/>Jenis: {{.Data.Kind}}<br/>Nomor: {{.Data.Number}}<br/>Kantor: {{.Data.Office}}{{if eq .Data.Kind "Kuitansi"}}<br/>Total: Rp {{.Data.Total}} · Dibayar: Rp {{.Data.Paid}}{{end}}{{if eq .Data.Kind "Akta"}}<br/>Tanda tangan internal: {{.Data.Sigs}} tercatat{{end}}<br/>Status: <span class="badge bg-green-lt">{{.Data.Status}}</span></div>{{end}}
<p class="text-secondary small mt-3 mb-0">Hanya dokumen dengan kode HMAC yang cocok yang dinyatakan asli. Bukan pengganti minuta/final notaris.</p>
</div></div>
<p class="text-center mt-3"><a href="/">← Beranda</a></p>
</div></div></body></html>{{end}}

{{define "portal_invoices"}}{{template "head" .}}{{template "page_open" .}}
<div class="alert alert-info">Tagihan Anda. Untuk membayar: transfer sesuai nominal, lalu unggah bukti — staf memverifikasi dan status diperbarui.</div>
<div class="card"><div class="card-header"><h3 class="card-title">Tagihan Saya</h3></div>
<div class="table-responsive"><table class="table card-table"><thead><tr><th>Nomor</th><th>Total</th><th>Dibayar</th><th>Sisa</th><th>Jatuh tempo</th><th>Status</th><th>Kuitansi</th><th>Bukti</th></tr></thead>
<tbody>{{range .Data}}<tr><td>{{.Number}}</td><td>{{.Total}}</td><td>{{.Paid}}</td><td>{{.Outstanding}}</td><td>{{.Due}}</td><td><span class="badge bg-blue-lt">{{.Status}}</span></td>
<td><a class="btn btn-sm btn-ghost-primary" href="/portal/invoices/{{.ID}}/receipt">Kuitansi</a></td>
<td>{{if ne .Status "PAID"}}<form method="post" action="/portal/pay" enctype="multipart/form-data" class="d-flex gap-1">{{template "csrf" $}}<input type="hidden" name="invoice_id" value="{{.ID}}"/><input class="form-control form-control-sm" type="file" name="bukti" required/><button class="btn btn-sm btn-primary" type="submit">Kirim</button></form>{{else}}<span class="text-success">Lunas ✓</span>{{end}}</td></tr>
{{else}}<tr><td colspan="8" class="text-center text-secondary py-3">Belum ada tagihan.</td></tr>{{end}}</tbody></table></div></div>
{{template "page_close" .}}{{end}}

{{define "portal_pay_ok"}}{{template "head" .}}{{template "page_open" .}}
<div class="card"><div class="card-body text-center py-5">
<h2>Konfirmasi Diterima ✓</h2>
<p class="text-secondary">Bukti untuk tagihan #{{.Data.Inv}} tersimpan (berkas #{{.Data.File}}). Staf keuangan akan memverifikasi dan memperbarui status.</p>
<a class="btn btn-primary" href="/portal/invoices">Kembali ke Tagihan</a>
</div></div>
{{template "page_close" .}}{{end}}
